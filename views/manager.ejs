<!DOCTYPE html>
<html lang="en" data-page="manager">
<head>
    <%- include('partials/head', { page: 'manager', pageTitle: "Manager Dashboard — Quality Boba" }) %>
    <script src="/js/pages/manager-navigation.js" defer></script>
    <script src="/js/shared/price-validation.js" defer></script>
    <script src="/js/shared/menu.js" defer></script>
    <script src="/js/shared/menu-item-validation.js" defer></script>
    <script src="/js/components/manager-menu-row.js" defer></script>
    <script src="/js/pages/manager-menu-editor.js" defer></script>
    <script src="/js/shared/sales-range.js" defer></script>
    <script src="/js/components/manager-sales-chart.js" defer></script>
    <script src="/js/pages/manager-sales.js" defer></script>
    <script src="/js/pages/manager-menu.js" defer></script>
    <script src="/js/pages/manager-menu-filters.js" defer></script>
</head>
<body>
    <header class="app-header">
        <div class="header-left">
            <span class="brand-name">Quality Boba</span>
            <span class="header-divider">/</span>
            <h1>Manager Dashboard</h1>
        </div>
        <div class="header-right">
            <button type="button" id="contrast-toggle-btn" class="contrast-toggle-btn" aria-pressed="false" aria-label="Toggle High Contrast Mode">
                <span aria-hidden="true">👁️</span> Contrast: <strong class="contrast-state-text">Off</strong>
            </button>
            <a href="/logout?next=/manager" class="manager-logout">Sign out</a>
        </div>
    </header>

    <% const inventoryUnavailable = typeof inventoryError === 'undefined' || inventoryError || typeof inventoryItems === 'undefined'; %>
    <% const menuUnavailable = typeof menuError === 'undefined' || menuError || typeof menuItems === 'undefined'; %>
    <% const canAddMenuItem = !menuUnavailable && !inventoryUnavailable && inventoryItems.length > 0; %>
    <main class="manager-layout">
        <aside class="manager-sidebar">
            <div class="sidebar-heading"><p class="eyebrow">Management</p><p>Your store, at a glance.</p></div>
            <nav class="manager-nav" aria-label="Manager workspaces">
                <a href="#sales-report" data-manager-link>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h16M8 15v-4m5 4V7m5 8V3"/></svg>
                    <span>Reports<small>Sales &amp; performance</small></span>
                </a>
                <a href="#menu-management" data-manager-link>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5zM9 9h6m-6 4h6m-6 4h3"/></svg>
                    <span>Menu<small>Items, recipes &amp; prices</small></span>
                </a>
                <a href="#inventory" data-manager-link>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 7 9-4 9 4-9 4zm0 0v10l9 4 9-4V7m-9 4v10"/></svg>
                    <span>Inventory<small>Ingredients &amp; stock levels</small></span>
                    <% if (!inventoryUnavailable && lowStockCount > 0) { %><span class="nav-count" aria-label="<%= lowStockCount %> low-stock ingredients"><%= lowStockCount %></span><% } %>
                </a>
            </nav>
            <div class="sidebar-note"><strong>Stock check</strong>
                <p><%= inventoryUnavailable ? 'Inventory is currently unavailable.' : lowStockCount === 0 ? 'No ingredients are below their reorder thresholds.' : lowStockCount + (lowStockCount === 1 ? ' ingredient is' : ' ingredients are') + ' below their reorder thresholds.' %></p>
                <a href="#inventory">Review inventory &rarr;</a>
            </div>
        </aside>
        <div class="manager-workspaces">
            <%- include('partials/manager/reports') %>
            <%- include('partials/manager/menu', { menuUnavailable, inventoryUnavailable, canAddMenuItem }) %>
            <%- include('partials/manager/inventory', { inventoryUnavailable }) %>
        </div>
    </main>
</body>
</html>
