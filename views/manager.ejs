<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard &mdash; Quality Boba</title>
    <style>
        :root {
            --bg-canvas: #f6f3ed;
            --bg-card: #ffffff;
            --bg-surface-subtle: #fbf9f5;
            --border: #dfd7cb;
            --border-subtle: #ede7dc;
            --text-main: #231810;
            --text-muted: #6e6053;
            --text-inverse: #fdfbf7;
            --brand: #382013;
            --brand-dark: #2b180d;
            --accent-green: #1f6339;
            --accent-green-hover: #174d2c;
            --accent-green-bg: #eaf3ec;
            --accent-amber: #92400e;
            --accent-amber-bg: #fffbeb;
            --accent-amber-border: #fde68a;
            --danger: #991b1b;
            --danger-bg: #fee2e2;
            --focus: #1f6339;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background-color: var(--bg-canvas);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.45;
        }

        /* Top Header */
        .app-header {
            background-color: var(--brand);
            color: var(--text-inverse);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--brand-dark);
        }

        .header-left {
            display: flex;
            align-items: baseline;
            gap: 10px;
        }

        .brand-name {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            color: #d8c8b8;
        }

        .header-divider {
            color: #7d6555;
            font-weight: 300;
        }

        .app-header h1 {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text-inverse);
        }

        /* Main Workspace */
        main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px;
        }

        .page-header {
            margin-bottom: 20px;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .page-desc {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* KPIs */
        .kpis {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 16px 18px;
        }

        dt {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        dd {
            margin: 6px 0 0;
        }

        .value {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-main);
            font-variant-numeric: tabular-nums;
            line-height: 1.2;
        }

        .note {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-top: 2px;
        }

        /* Content Sections */
        .sections {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 20px;
        }

        section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 20px;
        }

        h2 {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 4px;
            letter-spacing: -0.01em;
        }

        .section-desc {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        /* Form */
        #add-menu-form {
            background: var(--bg-surface-subtle);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 16px;
            margin-bottom: 20px;
        }

        #add-menu-form h3 { font-size: 1rem; margin-bottom: 12px; }
        #add-menu-fields { border: none; min-width: 0; }
        .menu-item-fields { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; }
        #add-menu-form label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 4px; }
        #add-menu-form input, #add-menu-form select {
            width: 100%;
            min-width: 0;
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 8px 10px;
            color: var(--text-main);
            background: var(--bg-card);
            font: inherit;
            font-size: 0.9rem;
        }
        .recipe-fields { border: 1px solid var(--border); border-radius: 4px; padding: 12px; margin-top: 14px; min-width: 0; }
        .recipe-fields legend { padding: 0 6px; font-size: 0.88rem; font-weight: 700; }
        .recipe-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; gap: 10px; align-items: end; margin: 12px 0; }
        .recipe-row button, #add-ingredient {
            border: 1px solid var(--border);
            border-radius: 4px;
            background: var(--bg-card);
            color: var(--brand);
            padding: 8px 12px;
            font: inherit;
            font-size: 0.85rem;
            cursor: pointer;
        }
        #add-menu-submit { border: none; border-radius: 4px; background: var(--accent-green); color: white; padding: 9px 16px; font: inherit; font-size: 0.88rem; font-weight: 600; cursor: pointer; }
        #add-menu-status { color: var(--accent-green); font-size: 0.88rem; margin-top: 10px; }

        form#price-form {
            background: var(--bg-surface-subtle);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 16px;
            margin: 14px 0 18px;
            max-width: 480px;
        }

        form#price-form h3 {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        #selected-item {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--brand);
            margin-bottom: 10px;
        }

        form#price-form label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        input#new-price {
            width: 100%;
            max-width: 260px;
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 4px;
            font-size: 0.95rem;
            font-family: inherit;
            color: var(--text-main);
            background: #ffffff;
            margin-bottom: 8px;
        }

        input#new-price:focus-visible {
            border-color: var(--accent-green);
            outline: 2px solid var(--accent-green);
        }

        .form-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        #save-price {
            background: var(--accent-green);
            color: #ffffff;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
            transition: background 0.12s ease;
        }

        #save-price:hover:not(:disabled) {
            background: var(--accent-green-hover);
        }

        #cancel-price {
            background: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border);
            padding: 8px 14px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
        }

        #cancel-price:hover:not(:disabled) {
            background: #ffffff;
            color: var(--text-main);
        }

        button:disabled {
            opacity: 0.5;
            cursor: wait;
        }

        .error {
            color: var(--danger);
            font-weight: 600;
            font-size: 0.85rem;
            margin: 6px 0;
        }

        #price-status {
            color: var(--accent-green);
            font-weight: 600;
            font-size: 0.88rem;
            margin: 6px 0;
        }

        /* Data Tables */
        .table-scroll {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }

        caption {
            text-align: left;
            margin-bottom: 8px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        thead th {
            background: var(--bg-surface-subtle);
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
        }

        tbody th, tbody td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border-subtle);
            font-variant-numeric: tabular-nums;
        }

        tbody th {
            font-weight: 600;
            color: var(--text-main);
        }

        tbody tr:last-child th,
        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background-color: var(--bg-surface-subtle);
        }

        .update-price {
            background: transparent;
            color: var(--brand);
            border: 1px solid var(--border);
            padding: 5px 10px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.12s ease;
        }

        .update-price:hover:not(:disabled) {
            background: var(--brand);
            color: #ffffff;
            border-color: var(--brand);
        }

        /* Stock Status */
        .low-stock {
            background-color: var(--accent-amber-bg) !important;
        }

        .low-stock td:last-child {
            color: var(--accent-amber);
            font-weight: 700;
        }

        /* Sales reporting */
        .sales-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 12px;
        }

        #sales-refresh {
            background: var(--accent-green);
            color: #ffffff;
            border: 1px solid var(--accent-green);
            border-radius: 4px;
            padding: 8px 14px;
            font: inherit;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        #sales-refresh:hover:not(:disabled) {
            background: var(--accent-green-hover);
        }

        #sales-status {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 16px;
        }

        #sales-chart-scroll {
            overflow-x: auto;
        }

        #sales-chart {
            display: block;
            width: 100%;
            min-width: 840px;
            height: auto;
        }

        .sales-grid {
            stroke: var(--border-subtle);
            stroke-width: 1;
        }

        .sales-axis {
            fill: var(--text-muted);
            font-size: 12px;
            font-variant-numeric: tabular-nums;
        }

        .sales-axis-title {
            fill: var(--text-main);
            font-size: 13px;
            font-weight: 600;
        }

        .sales-bar { fill: var(--accent-green); }
        .sales-bar:hover { fill: var(--brand); }

        .sales-details { margin-top: 16px; }
        .chart-scroll-hint { display: none; }
        .sales-details summary {
            color: var(--brand);
            font-weight: 600;
            cursor: pointer;
            padding: 8px 0;
        }

        #sales-table caption { padding: 12px 14px 0; }
        #sales-table tfoot th, #sales-table tfoot td {
            border-top: 2px solid var(--border);
            background: var(--bg-surface-subtle);
            padding: 12px 14px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        /* Placeholders */
        .placeholder {
            padding: 24px;
            background: var(--bg-surface-subtle);
            border: 1px dashed var(--border);
            border-radius: 4px;
            color: var(--text-muted);
            font-size: 0.9rem;
            text-align: center;
        }

        a {
            color: var(--brand);
            font-weight: 600;
        }

        :focus-visible {
            outline: 2px solid var(--focus);
            outline-offset: 2px;
        }

        @media (max-width: 768px) {
            .menu-item-fields, .recipe-row { grid-template-columns: minmax(0, 1fr); }
            .recipe-row { padding-bottom: 12px; border-bottom: 1px solid var(--border); }
            .recipe-row button { justify-self: start; }
            .chart-scroll-hint { display: block; margin-top: 6px; }
            main {
                padding: 16px;
            }
            .kpis {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <script src="/js/price-validation.js" defer></script>
    <script src="/js/manager.js" defer></script>
    <script src="/js/manager-sales.js" defer></script>
    <script src="/js/menu-item-validation.js" defer></script>
    <script src="/js/manager-menu.js" defer></script>
</head>
<body>
    <header class="app-header">
        <div class="header-left">
            <span class="brand-name">Quality Boba</span>
            <span class="header-divider">/</span>
            <h1>Manager Dashboard</h1>
        </div>
    </header>

    <% const inventoryUnavailable = typeof inventoryError === 'undefined' || inventoryError || typeof inventoryItems === 'undefined'; %>
    <% const menuUnavailable = typeof menuError === 'undefined' || menuError || typeof menuItems === 'undefined'; %>
    <% const canAddMenuItem = !menuUnavailable && !inventoryUnavailable && inventoryItems.length > 0; %>
    <main>
        <header class="page-header">
            <h2 class="page-title">Store Overview</h2>
            <p class="page-desc">Today&rsquo;s sales, menu pricing, and inventory monitoring.</p>
        </header>

        <dl class="kpis" aria-label="Today's key performance indicators">
            <div class="kpi-card">
                <dt>Today&rsquo;s Sales</dt>
                <dd class="value" id="sales-revenue">Loading&hellip;</dd>
                <dd class="note" id="sales-revenue-note">Completed orders &middot; USD</dd>
            </div>
            <div class="kpi-card">
                <dt>Orders Processed</dt>
                <dd class="value" id="sales-orders">Loading&hellip;</dd>
                <dd class="note" id="sales-orders-note">Completed orders today</dd>
            </div>
            <div class="kpi-card">
                <dt>Inventory Alerts</dt>
                <dd class="value" id="inventory-alert-count"><%= inventoryUnavailable ? 'Unavailable' : lowStockCount %></dd>
                <dd class="note"><%= inventoryUnavailable ? 'Stock data unavailable' : 'Low-stock ingredients' %></dd>
            </div>
        </dl>

        <div class="sections">
            <section class="menu-management" aria-labelledby="menu-heading">
                <h2 id="menu-heading">Menu Management</h2>
                <p class="section-desc">Current menu prices in USD.</p>
                <form id="add-menu-form" aria-labelledby="add-menu-heading" novalidate>
                    <h3 id="add-menu-heading">Add Menu Item</h3>
                    <% if (!canAddMenuItem) { %>
                        <p class="error">Menu and ingredient data must be available before adding a drink. Please <a href="/manager">reload the page</a>.</p>
                    <% } %>
                    <fieldset id="add-menu-fields" <%= canAddMenuItem ? '' : 'disabled' %>>
                        <div class="menu-item-fields">
                            <div><label for="add-menu-name">Item name</label><input id="add-menu-name" name="name" type="text" required maxlength="100" aria-describedby="add-menu-error"></div>
                            <div><label for="add-menu-price">Price (USD)</label><input id="add-menu-price" name="price" type="text" inputmode="decimal" required maxlength="100" aria-describedby="add-menu-price-rule add-menu-error"></div>
                        </div>
                        <p id="add-menu-price-rule" class="note">Zero is allowed. Use decimal notation with no fractions smaller than a cent; maximum $99,999,999.99.</p>
                        <fieldset class="recipe-fields" aria-describedby="recipe-rule">
                            <legend>Recipe ingredients</legend>
                            <p id="recipe-rule" class="note">Choose at least one ingredient. Use whole inventory units per drink, including packaging such as cups. Select each ingredient only once.</p>
                            <div id="recipe-editor"></div>
                            <button id="add-ingredient" type="button">Add ingredient</button>
                        </fieldset>
                        <div class="form-actions"><button id="add-menu-submit" type="submit">Add menu item</button></div>
                    </fieldset>
                    <p id="add-menu-error" class="error" role="alert" tabindex="-1"></p>
                    <p id="add-menu-status" role="status" aria-atomic="true"></p>
                    <noscript><p class="error">Enable JavaScript to add menu items and recipe ingredients.</p></noscript>
                </form>
                <template id="recipe-row-template">
                    <div class="recipe-row">
                        <div><label data-ingredient-label></label><select data-ingredient required><option value="">Choose an ingredient</option><% if (!inventoryUnavailable) { inventoryItems.forEach(item => { %><option value="<%= item.inventory_item_id %>"><%= item.name %></option><% }); } %></select></div>
                        <div><label data-quantity-label></label><input data-quantity type="number" inputmode="numeric" min="1" max="2147483647" step="1" value="1" required></div>
                        <button type="button" data-remove-ingredient>Remove</button>
                    </div>
                </template>
                <p id="price-status" role="status" aria-atomic="true"></p>
                <form id="price-form" aria-labelledby="price-form-heading" hidden novalidate>
                    <h3 id="price-form-heading">Update Price</h3>
                    <p id="selected-item"></p>
                    <label for="new-price">New price (USD)</label>
                    <input id="new-price" name="price" type="text" inputmode="decimal" required maxlength="100" aria-describedby="selected-item price-rule price-error">
                    <p id="price-rule" class="note">Zero is allowed. Use decimal notation with no fractions smaller than a cent; maximum $99,999,999.99.</p>
                    <p id="price-error" class="error" role="alert"></p>
                    <div class="form-actions">
                        <button id="save-price" type="submit">Save</button>
                        <button id="cancel-price" type="button">Cancel</button>
                    </div>
                </form>
                <% if (typeof menuError === 'undefined' || menuError || typeof menuItems === 'undefined') { %>
                    <p class="placeholder" role="alert">Unable to load the menu from the database. Please <a href="/manager">try again</a>.</p>
                <% } else { %>
                    <p id="menu-empty" class="placeholder" <%= menuItems.length ? 'hidden' : '' %>>No menu items are available. Add your first drink above.</p>
                    <div id="manager-menu-region" class="table-scroll" role="region" aria-label="Menu prices" tabindex="0" <%= menuItems.length ? '' : 'hidden' %>>
                        <table id="manager-menu">
                            <caption>Menu items and current prices (USD)</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Item name</th>
                                    <th scope="col">Current price</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody id="manager-menu-body">
                                <% const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }); %>
                                <% menuItems.forEach((item) => { %>
                                    <tr>
                                        <th scope="row" data-item-name><%= item.name %></th>
                                        <td data-item-price><%= currency.format(item.price) %></td>
                                        <td>
                                            <button type="button" class="update-price" data-menu-item-id="<%= item.menu_item_id %>" data-price="<%= item.price %>" aria-label="Update price for <%= item.name %>" aria-controls="price-form">Update Price</button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section id="inventory" aria-labelledby="inventory-heading">
                <h2 id="inventory-heading">Inventory</h2>
                <p id="inventory-rule" class="section-desc">Low stock means the current quantity is below the ingredient&rsquo;s reorder threshold. A quantity equal to the threshold is not low stock.</p>
                <% if (inventoryUnavailable) { %>
                    <p class="placeholder" role="alert">Unable to load inventory from the database. Please <a href="/manager">try again</a>.</p>
                <% } else if (inventoryItems.length === 0) { %>
                    <p class="placeholder">No inventory ingredients are available.</p>
                <% } else { %>
                    <div class="table-scroll" role="region" aria-label="Ingredient inventory" tabindex="0">
                        <table aria-describedby="inventory-rule">
                            <caption>Ingredient quantities and stock status</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Ingredient</th>
                                    <th scope="col">Current quantity</th>
                                    <th scope="col">Reorder threshold</th>
                                    <th scope="col">Stock status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% inventoryItems.forEach((item) => { %>
                                    <tr data-inventory-item-id="<%= item.inventory_item_id %>" data-stock-status="<%= item.isLowStock ? 'low' : 'ok' %>" class="<%= item.isLowStock ? 'low-stock' : '' %>">
                                        <th scope="row"><%= item.name %></th>
                                        <td><%= item.current_fill_level %></td>
                                        <td><%= item.reorder_threshold %></td>
                                        <td><%= item.isLowStock ? 'Low stock' : 'In stock' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section id="sales-report" aria-labelledby="sales-heading">
                <div class="sales-header">
                    <div>
                        <h2 id="sales-heading">Sales Reporting</h2>
                        <p class="section-desc">Hourly revenue from completed orders, including tax. Updates every minute.</p>
                    </div>
                    <button id="sales-refresh" type="button" aria-controls="sales-visuals" disabled>Refresh sales</button>
                </div>
                <p id="sales-status" role="status" aria-atomic="true">Loading today&rsquo;s sales&hellip;</p>
                <p id="sales-error" class="error" role="alert" hidden></p>
                <noscript><p class="error">Enable JavaScript to load the sales chart and daily totals.</p></noscript>
                <div id="sales-visuals" aria-busy="true" hidden>
                    <figure>
                        <div id="sales-chart-scroll" role="region" aria-label="Hourly revenue chart, scroll horizontally for all hours" tabindex="0">
                            <svg id="sales-chart" viewBox="0 0 960 330" role="img" aria-labelledby="sales-chart-title sales-chart-description"></svg>
                        </div>
                        <figcaption class="note">Revenue in US dollars (USD). Each bar represents one business hour. Exact values are in the table below.</figcaption>
                        <p class="note chart-scroll-hint">Scroll the chart horizontally to see all 24 hours.</p>
                    </figure>
                    <details class="sales-details">
                        <summary>View hourly sales table</summary>
                        <div class="table-scroll" role="region" aria-label="Hourly sales values" tabindex="0">
                            <table id="sales-table">
                                <caption id="sales-table-caption"></caption>
                                <thead><tr><th scope="col">Hour</th><th scope="col">Revenue (USD)</th><th scope="col">Completed orders</th></tr></thead>
                                <tbody></tbody>
                                <tfoot><tr><th scope="row">Daily total</th><td id="sales-table-revenue"></td><td id="sales-table-orders"></td></tr></tfoot>
                            </table>
                        </div>
                    </details>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
