<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard &mdash; Quality Boba</title>
    <style>
        :root {
            --bg-canvas: #f6f3ed;
            --bg-card: #ffffff;
            --bg-surface-subtle: #fbf9f5;
            --border: #dfd7cb;
            --border-subtle: #ede7dc;
            --text-main: #231810;
            --text-muted: #6e6053;
            --text-inverse: #fdfbf7;
            --brand: #382013;
            --brand-dark: #2b180d;
            --accent-green: #1f6339;
            --accent-green-hover: #174d2c;
            --accent-green-bg: #eaf3ec;
            --accent-amber: #92400e;
            --accent-amber-bg: #fffbeb;
            --accent-amber-border: #fde68a;
            --danger: #991b1b;
            --danger-bg: #fee2e2;
            --focus: #1f6339;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background-color: var(--bg-canvas);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.45;
        }

        /* Top Header */
        .app-header {
            background-color: var(--brand);
            color: var(--text-inverse);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--brand-dark);
        }

        .header-left {
            display: flex;
            align-items: baseline;
            gap: 10px;
        }

        .brand-name {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            color: #d8c8b8;
        }

        .header-divider {
            color: #7d6555;
            font-weight: 300;
        }

        .app-header h1 {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text-inverse);
        }

        /* Main Workspace */
        main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px;
        }

        .page-header {
            margin-bottom: 20px;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .page-desc {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* KPIs */
        .kpis {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 16px 18px;
        }

        dt {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        dd {
            margin: 6px 0 0;
        }

        .value {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-main);
            font-variant-numeric: tabular-nums;
            line-height: 1.2;
        }

        .note {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-top: 2px;
        }

        /* Content Sections */
        .sections {
            display: grid;
            gap: 20px;
        }

        section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 20px;
        }

        h2 {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 4px;
            letter-spacing: -0.01em;
        }

        .section-desc {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        /* Form */
        form#price-form {
            background: var(--bg-surface-subtle);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 16px;
            margin: 14px 0 18px;
            max-width: 480px;
        }

        form#price-form h3 {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        #selected-item {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--brand);
            margin-bottom: 10px;
        }

        form#price-form label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        input#new-price {
            width: 100%;
            max-width: 260px;
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 4px;
            font-size: 0.95rem;
            font-family: inherit;
            color: var(--text-main);
            background: #ffffff;
            margin-bottom: 8px;
        }

        input#new-price:focus-visible {
            border-color: var(--accent-green);
            outline: 2px solid var(--accent-green);
        }

        .form-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        #save-price {
            background: var(--accent-green);
            color: #ffffff;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
            transition: background 0.12s ease;
        }

        #save-price:hover:not(:disabled) {
            background: var(--accent-green-hover);
        }

        #cancel-price {
            background: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border);
            padding: 8px 14px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
        }

        #cancel-price:hover:not(:disabled) {
            background: #ffffff;
            color: var(--text-main);
        }

        button:disabled {
            opacity: 0.5;
            cursor: wait;
        }

        .error {
            color: var(--danger);
            font-weight: 600;
            font-size: 0.85rem;
            margin: 6px 0;
        }

        #price-status {
            color: var(--accent-green);
            font-weight: 600;
            font-size: 0.88rem;
            margin: 6px 0;
        }

        /* Data Tables */
        .table-scroll {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }

        caption {
            text-align: left;
            margin-bottom: 8px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        thead th {
            background: var(--bg-surface-subtle);
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
        }

        tbody th, tbody td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border-subtle);
            font-variant-numeric: tabular-nums;
        }

        tbody th {
            font-weight: 600;
            color: var(--text-main);
        }

        tbody tr:last-child th,
        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background-color: var(--bg-surface-subtle);
        }

        .update-price {
            background: transparent;
            color: var(--brand);
            border: 1px solid var(--border);
            padding: 5px 10px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.12s ease;
        }

        .update-price:hover:not(:disabled) {
            background: var(--brand);
            color: #ffffff;
            border-color: var(--brand);
        }

        /* Stock Status */
        .low-stock {
            background-color: var(--accent-amber-bg) !important;
        }

        .low-stock td:last-child {
            color: var(--accent-amber);
            font-weight: 700;
        }

        /* Placeholders */
        .placeholder {
            padding: 24px;
            background: var(--bg-surface-subtle);
            border: 1px dashed var(--border);
            border-radius: 4px;
            color: var(--text-muted);
            font-size: 0.9rem;
            text-align: center;
        }

        a {
            color: var(--brand);
            font-weight: 600;
        }

        :focus-visible {
            outline: 2px solid var(--focus);
            outline-offset: 2px;
        }

        @media (max-width: 768px) {
            main {
                padding: 16px;
            }
            .kpis {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <script src="/js/price-validation.js" defer></script>
    <script src="/js/manager.js" defer></script>
</head>
<body>
    <header class="app-header">
        <div class="header-left">
            <span class="brand-name">Quality Boba</span>
            <span class="header-divider">/</span>
            <h1>Manager Dashboard</h1>
        </div>
    </header>

    <% const inventoryUnavailable = typeof inventoryError === 'undefined' || inventoryError || typeof inventoryItems === 'undefined'; %>
    <main>
        <header class="page-header">
            <h2 class="page-title">Store Overview</h2>
            <p class="page-desc">Menu pricing controls and real-time inventory monitoring.</p>
        </header>

        <dl class="kpis" aria-label="Today's key performance indicators">
            <div class="kpi-card">
                <dt>Today&rsquo;s Sales</dt>
                <dd class="value">Unavailable</dd>
                <dd class="note">Awaiting sales data</dd>
            </div>
            <div class="kpi-card">
                <dt>Orders Processed</dt>
                <dd class="value">Unavailable</dd>
                <dd class="note">Awaiting today&rsquo;s order data</dd>
            </div>
            <div class="kpi-card">
                <dt>Inventory Alerts</dt>
                <dd class="value" id="inventory-alert-count"><%= inventoryUnavailable ? 'Unavailable' : lowStockCount %></dd>
                <dd class="note"><%= inventoryUnavailable ? 'Stock data unavailable' : 'Low-stock ingredients' %></dd>
            </div>
        </dl>

        <div class="sections">
            <section class="menu-management" aria-labelledby="menu-heading">
                <h2 id="menu-heading">Menu Management</h2>
                <p class="section-desc">Current menu prices in USD.</p>
                <p id="price-status" role="status" aria-atomic="true"></p>
                <form id="price-form" aria-labelledby="price-form-heading" hidden novalidate>
                    <h3 id="price-form-heading">Update Price</h3>
                    <p id="selected-item"></p>
                    <label for="new-price">New price (USD)</label>
                    <input id="new-price" name="price" type="text" inputmode="decimal" required maxlength="100" aria-describedby="selected-item price-rule price-error">
                    <p id="price-rule" class="note">Zero is allowed. Use decimal notation with no fractions smaller than a cent; maximum $99,999,999.99.</p>
                    <p id="price-error" class="error" role="alert"></p>
                    <div class="form-actions">
                        <button id="save-price" type="submit">Save</button>
                        <button id="cancel-price" type="button">Cancel</button>
                    </div>
                </form>
                <% if (typeof menuError === 'undefined' || menuError || typeof menuItems === 'undefined') { %>
                    <p class="placeholder" role="alert">Unable to load the menu from the database. Please <a href="/manager">try again</a>.</p>
                <% } else if (menuItems.length === 0) { %>
                    <p class="placeholder">No menu items are available.</p>
                <% } else { %>
                    <div class="table-scroll" role="region" aria-label="Menu prices" tabindex="0">
                        <table>
                            <caption>Menu items and current prices (USD)</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Item name</th>
                                    <th scope="col">Current price</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }); %>
                                <% menuItems.forEach((item) => { %>
                                    <tr>
                                        <th scope="row" data-item-name><%= item.name %></th>
                                        <td data-item-price><%= currency.format(item.price) %></td>
                                        <td>
                                            <button type="button" class="update-price" data-menu-item-id="<%= item.menu_item_id %>" data-price="<%= item.price %>" aria-label="Update price for <%= item.name %>" aria-controls="price-form">Update Price</button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section id="inventory" aria-labelledby="inventory-heading">
                <h2 id="inventory-heading">Inventory</h2>
                <p id="inventory-rule" class="section-desc">Low stock means the current quantity is below the ingredient&rsquo;s reorder threshold. A quantity equal to the threshold is not low stock.</p>
                <% if (inventoryUnavailable) { %>
                    <p class="placeholder" role="alert">Unable to load inventory from the database. Please <a href="/manager">try again</a>.</p>
                <% } else if (inventoryItems.length === 0) { %>
                    <p class="placeholder">No inventory ingredients are available.</p>
                <% } else { %>
                    <div class="table-scroll" role="region" aria-label="Ingredient inventory" tabindex="0">
                        <table aria-describedby="inventory-rule">
                            <caption>Ingredient quantities and stock status</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Ingredient</th>
                                    <th scope="col">Current quantity</th>
                                    <th scope="col">Reorder threshold</th>
                                    <th scope="col">Stock status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% inventoryItems.forEach((item) => { %>
                                    <tr data-inventory-item-id="<%= item.inventory_item_id %>" data-stock-status="<%= item.isLowStock ? 'low' : 'ok' %>" class="<%= item.isLowStock ? 'low-stock' : '' %>">
                                        <th scope="row"><%= item.name %></th>
                                        <td><%= item.current_fill_level %></td>
                                        <td><%= item.reorder_threshold %></td>
                                        <td><%= item.isLowStock ? 'Low stock' : 'In stock' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section aria-labelledby="sales-heading">
                <h2 id="sales-heading">Sales Reporting</h2>
                <p class="section-desc">Sales summaries and reporting tools will appear here when sales data is connected.</p>
                <p class="placeholder">Sales reporting module &mdash; scheduled for next sprint.</p>
            </section>
        </div>
    </main>
</body>
</html>
