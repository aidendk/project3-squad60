<!DOCTYPE html>
<html lang="en" data-page="index">
<head>
    <%- include('partials/head', { page: 'index', pageTitle: "Quality Boba — System Portal" }) %>
</head>
<body>

    <main class="portal-container">
        <header class="portal-header">
            <p class="brand-eyebrow">Quality Boba &bull; Squad 60</p>
            <h1 class="portal-title">Point of Sale System</h1>

            <div id="database-status" class="database-status" role="status">
                <span class="status-dot" aria-hidden="true"></span>
                <span id="database-status-text">Database: Checking...</span>
            </div>
            <noscript>
                <p class="database-noscript">Enable JavaScript to display live database status.</p>
            </noscript>
        </header>

        <nav class="portal-grid" aria-label="POS interfaces">
            <a class="portal-card" href="/kiosk">
                <div>
                    <h2 class="card-title">Customer Kiosk</h2>
                    <p class="card-desc">Self-service lobby terminal for customer ordering and accessibility.</p>
                </div>
                <span class="card-action">Launch Kiosk &rarr;</span>
            </a>

            <a class="portal-card" href="/cashier">
                <div>
                    <h2 class="card-title">Cashier Register</h2>
                    <p class="card-desc">Front-counter order entry, custom ticket modifiers, and checkout.</p>
                </div>
                <span class="card-action">Launch Cashier &rarr;</span>
            </a>

            <a class="portal-card" href="/manager">
                <div>
                    <h2 class="card-title">Manager Dashboard</h2>
                    <p class="card-desc">Real-time menu item pricing updates and ingredient inventory tracking.</p>
                </div>
                <span class="card-action">Launch Manager &rarr;</span>
            </a>

            <a class="portal-card" href="/kitchen">
                <div>
                    <h2 class="card-title">Kitchen Display</h2>
                    <p class="card-desc">Live drink queue, recipe customizations, and barista ticket fulfillment.</p>
                </div>
                <span class="card-action">Launch Display &rarr;</span>
            </a>
        </nav>

        <footer>
            <span>Texas A&amp;M University &bull; CSCE 331</span>
            <span>Squad 60</span>
        </footer>
    </main>

    <script src="/js/pages/index.js"></script>
</body>
</html>
