<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quality Boba (Squad 60)</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f3ece2;
            color: #2b2118;
        }

        header {
            padding: 24px 32px;
            background: #542f1d;
            color: #fffdf9;
        }

        .header-content {
            max-width: 1100px;
            margin: 0 auto;
        }

        .eyebrow {
            margin: 0 0 4px;
            font-size: 0.9rem;
            font-weight: bold;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            font-size: clamp(1.8rem, 4vw, 2.5rem);
        }

        main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 40px 32px;
        }

        h2 {
            margin: 0 0 10px;
            font-size: 1.8rem;
        }

        .intro {
            margin: 0 0 24px;
            color: #665343;
            font-size: 1.1rem;
            line-height: 1.6;
        }

        .database-status {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            max-width: 100%;
            margin: 0 0 28px;
            padding: 12px 18px;
            border: 2px solid #e5d5c3;
            border-radius: 999px;
            background: #fffdf9;
            font-weight: bold;
        }

        .status-dot {
            width: 12px;
            height: 12px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #776348;
        }

        .database-status.connected .status-dot {
            background: #276447;
        }

        .database-status.unavailable .status-dot {
            background: #a12c2c;
        }

        .portal-links {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px;
        }

        .portal-card {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            min-width: 0;
            padding: 28px;
            background: #fffdf9;
            border: 2px solid #e5d5c3;
            border-radius: 24px;
            color: inherit;
            text-decoration: none;
            box-shadow: 0 8px 24px rgba(84, 47, 29, 0.08);
        }

        .portal-card:hover {
            border-color: #542f1d;
            background: #fffaf3;
        }

        .portal-card:focus-visible {
            outline: 3px solid #542f1d;
            outline-offset: 5px;
        }

        .portal-card h3 {
            margin: 0 0 12px;
            font-size: 1.4rem;
        }

        .portal-card p {
            margin: 0 0 24px;
            color: #665343;
            font-size: 1rem;
            line-height: 1.6;
        }

        .launch-label {
            display: inline-block;
            margin-top: auto;
            padding: 12px 20px;
            background: #542f1d;
            border-radius: 999px;
            color: #fffdf9;
            font-size: 1rem;
            font-weight: bold;
        }

        footer {
            padding: 8px 24px 28px;
            color: #665343;
            text-align: center;
            font-size: 0.9rem;
        }

        @media (max-width: 600px) {
            header {
                padding: 24px 20px;
            }

            main {
                padding: 28px 20px;
            }

            .portal-links {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .portal-card {
                padding: 24px;
            }
        }
    </style>
</head>

<body>
    <header>
        <div class="header-content">
            <p class="eyebrow">Portal Hub &bull; Squad 60</p>
            <h1>Quality Boba</h1>
        </div>
    </header>

    <main>
        <h2>Select an interface</h2>
        <p class="intro">
            Choose a screen below to get started.
        </p>

        <div id="database-status" class="database-status" role="status">
            <span class="status-dot" aria-hidden="true"></span>
            <span id="database-status-text">Database: Checking...</span>
        </div>

        <noscript>
            <p>Enable JavaScript to display live database status.</p>
        </noscript>

        <nav class="portal-links" aria-label="POS interfaces">
            <a class="portal-card" href="/kiosk">
                <h3>Customer Kiosk</h3>
                <p>Browse the menu and place an order.</p>
                <span class="launch-label">Open Kiosk &rarr;</span>
            </a>

            <a class="portal-card" href="/cashier">
                <h3>Cashier Screen</h3>
                <p>Create and submit customer orders.</p>
                <span class="launch-label">Open Cashier &rarr;</span>
            </a>

            <a class="portal-card" href="/manager">
                <h3>Manager Dashboard</h3>
                <p>Manage employees, inventory, and reports.</p>
                <span class="launch-label">Open Manager &rarr;</span>
            </a>

            <a class="portal-card" href="/kitchen">
                <h3>Kitchen Display</h3>
                <p>View incoming orders and preparation status.</p>
                <span class="launch-label">Open Kitchen &rarr;</span>
            </a>
        </nav>
    </main>

    <footer>
        Quality Boba &bull; Squad 60
    </footer>

    <script>
        const statusBox = document.getElementById('database-status');
        const statusText = document.getElementById('database-status-text');

        async function checkDatabaseStatus() {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 12000);

            try {
                const response = await fetch('/health', {
                    cache: 'no-store',
                    signal: controller.signal
                });

                const data = await response.json();
                const connected =
                    response.ok && data.database === 'connected';

                statusBox.classList.toggle('connected', connected);
                statusBox.classList.toggle('unavailable', !connected);

                statusText.textContent = connected
                    ? 'Database: Connected'
                    : 'Database: Unavailable';
            } catch (err) {
                statusBox.classList.remove('connected');
                statusBox.classList.add('unavailable');
                statusText.textContent = 'Database: Unavailable';
            } finally {
                clearTimeout(timeout);
                setTimeout(checkDatabaseStatus, 30000);
            }
        }

        checkDatabaseStatus();
    </script>
</body>
</html>