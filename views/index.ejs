<!DOCTYPE html>
<html lang="en" data-page="index">
<head>
    <%- include('partials/head', {
        page: 'index',
        pageTitle: 'Quality Boba (Squad 60) — Portal Hub'
    }) %>
</head>
<body>
    <main class="portal-container">
        <header class="portal-header">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <p class="brand-eyebrow">Portal Hub</p>
                <button type="button" id="contrast-toggle-btn" class="contrast-toggle-btn" aria-pressed="false" aria-label="Toggle High Contrast Mode">
                    <span aria-hidden="true">👁️</span> Contrast: <strong class="contrast-state-text">Off</strong>
                </button>
            </div>
            <h1 class="portal-title">Quality Boba (Squad 60)</h1>
            <p class="portal-intro">
                Select an interface to begin.
            </p>
        </header>

        <nav class="portal-grid" aria-label="POS interfaces">
            <a class="portal-card" href="/manager">
                <div>
                    <h2 class="card-title">Manager Dashboard</h2>
                    <p class="card-desc">
                        Manage menu items, prices, inventory, and sales reports.
                    </p>
                </div>
                <span class="card-action" aria-hidden="true">
                    Open dashboard &rarr;
                </span>
            </a>

            <a class="portal-card" href="/cashier">
                <div>
                    <h2 class="card-title">Cashier Screen</h2>
                    <p class="card-desc">
                        Create and submit customer orders at the counter.
                    </p>
                </div>
                <span class="card-action" aria-hidden="true">
                    Open cashier &rarr;
                </span>
            </a>

            <a class="portal-card" href="/kiosk">
                <div>
                    <h2 class="card-title">Customer Kiosk</h2>
                    <p class="card-desc">
                        Browse drinks, customize selections, and place an order.
                    </p>
                </div>
                <span class="card-action" aria-hidden="true">
                    Open kiosk &rarr;
                </span>
            </a>

            <a class="portal-card" href="/kitchen">
                <div>
                    <h2 class="card-title">Kitchen Display</h2>
                    <p class="card-desc">
                        View incoming orders and mark completed drinks.
                    </p>
                </div>
                <span class="card-action" aria-hidden="true">
                    Open kitchen &rarr;
                </span>
            </a>
        </nav>

        <footer class="portal-footer">
            

            <div id="database-status" class="database-status" role="status">
                <span class="status-dot" aria-hidden="true"></span>
                <span id="database-status-text">Database: Checking...</span>
            </div>
        </footer>

        <noscript>
            <p class="database-noscript">
                Enable JavaScript to display live database status.
            </p>
        </noscript>
    </main>

    <script src="/js/pages/index.js"></script>
</body>
</html>