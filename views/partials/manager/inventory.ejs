<section id="inventory" class="manager-workspace" data-manager-panel aria-labelledby="inventory-heading">
    <div class="workspace-header">
        <div><p class="eyebrow">Stock monitoring</p><h2 id="inventory-heading" tabindex="-1">Inventory</h2>
            <p class="section-desc">Add ingredients and manage their quantities and reorder thresholds.</p></div>
        <div class="menu-row-actions"><span class="workspace-badge"><%= inventoryUnavailable ? 'Stock unavailable' : inventoryItems.length + (inventoryItems.length === 1 ? ' ingredient' : ' ingredients') %></span>
            <button id="inventory-add" type="button" class="manager-action" aria-controls="inventory-edit-form" <%= inventoryUnavailable ? 'disabled' : '' %>>Add ingredient</button></div>
    </div>
    <% if (!inventoryUnavailable) { %>
        <div class="inventory-summary"><strong id="inventory-alert-count"><%= lowStockCount %></strong>
            <span><%= lowStockCount === 1 ? 'ingredient needs' : 'ingredients need' %> attention</span></div>
    <% } %>
    <p id="inventory-rule" class="section-desc">Low stock means the current quantity is below the ingredient&rsquo;s reorder threshold. A quantity equal to the threshold is not low stock.</p>
    <p id="inventory-status" role="status" aria-atomic="true"></p>
    <p id="inventory-error" class="error" role="alert"></p>
    <form id="inventory-edit-form" class="manager-editor" aria-labelledby="inventory-edit-heading" aria-describedby="inventory-error" hidden>
        <h3 id="inventory-edit-heading">Edit inventory item</h3>
        <fieldset id="inventory-edit-fields">
            <label for="inventory-name">Ingredient name</label><input id="inventory-name" name="name" maxlength="100" required>
            <label for="inventory-quantity">Current quantity</label><input id="inventory-quantity" name="current_fill_level" type="number" min="0" max="2147483647" step="1" required>
            <label for="inventory-threshold">Reorder threshold</label><input id="inventory-threshold" name="reorder_threshold" type="number" min="0" max="2147483647" step="1" required>
            <div class="form-actions"><button id="inventory-save" type="submit" class="manager-save">Save changes</button><button id="inventory-cancel" type="button">Cancel</button></div>
        </fieldset>
    </form>
    <% if (inventoryUnavailable) { %>
        <p class="placeholder" role="alert">Unable to load inventory from the database. Please <a href="/manager">try again</a>.</p>
    <% } else { %>
        <div class="table-scroll" role="region" aria-label="Ingredient inventory" tabindex="0" <%= inventoryItems.length ? '' : 'hidden' %>>
            <table aria-describedby="inventory-rule">
                <caption>Ingredient quantities and stock status</caption>
                <thead>
                    <tr>
                        <th scope="col">Ingredient</th>
                        <th scope="col">Current quantity</th>
                        <th scope="col">Reorder threshold</th>
                        <th scope="col">Stock status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody id="inventory-body">
                    <% inventoryItems.forEach((item) => { %>
                        <tr data-inventory-item-id="<%= item.inventory_item_id %>" data-stock-status="<%= item.isLowStock ? 'low' : 'ok' %>" class="<%= item.isLowStock ? 'low-stock' : '' %>">
                            <th scope="row" data-inventory-name><%= item.name %></th>
                            <td data-inventory-quantity><%= item.current_fill_level %></td>
                            <td data-inventory-threshold><%= item.reorder_threshold %></td>
                            <td data-inventory-status><%= item.isLowStock ? 'Low stock' : 'In stock' %></td>
                            <td><div class="menu-row-actions"><button type="button" class="edit-inventory-item manager-action" aria-controls="inventory-edit-form" aria-label="Edit <%= item.name %>">Edit</button><button type="button" class="delete-inventory-item manager-action danger-action" aria-label="Delete <%= item.name %>">Delete</button></div></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <p id="inventory-empty" class="placeholder" <%= inventoryItems.length ? 'hidden' : '' %>>No inventory ingredients are available. Add your first ingredient above.</p>
    <% } %>
</section>
