<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Kiosk - Quality Boba</title>
    <style>
        :root {
            --bg: #f3ece3;
            --ink: #24180f;
            --muted: #5e4b3c;
            --card: #fffdf9;
            --line: #e3d5c4;
            --brand: #4e2c1c;
            --brand-ink: #fffdf9;
            --sidebar: #fffaf5;
            --focus: #0b57d0;
            --danger: #8d1d1d;
            --ok: #0f6b3c;
            --shadow: 0 10px 28px rgba(62, 36, 18, 0.08);
        }

        html {
            font-size: 18px;
        }

        html.large-text {
            font-size: 23px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            height: 100vh;
            display: grid;
            grid-template-rows: auto 1fr;
            overflow: hidden;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        button,
        input {
            font: inherit;
        }

        :focus-visible {
            outline: 3px solid var(--focus);
            outline-offset: 3px;
        }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .kiosk-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.75rem 1.25rem;
            background: var(--brand);
            color: var(--brand-ink);
        }

        .eyebrow {
            margin: 0;
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            font-size: 1.6rem;
            line-height: 1.1;
        }

        .a11y-controls {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 0.6rem;
        }

        .a11y-controls a,
        .a11y-controls button {
            min-height: 2.7rem;
            padding: 0.45rem 0.9rem;
            border: 2px solid #fffdf9;
            border-radius: 999px;
            background: transparent;
            color: #fffdf9;
            text-decoration: none;
            cursor: pointer;
        }

        .a11y-controls button[aria-pressed="true"] {
            background: #fffdf9;
            color: var(--brand);
        }

        .kiosk-main {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 23rem;
            min-height: 0;
        }

        .menu-panel,
        .cart-panel {
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .menu-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.9rem 1.25rem 0.4rem;
        }

        h2 {
            margin: 0;
            font-size: 1.25rem;
        }

        .category-tabs {
            display: flex;
            gap: 0.5rem;
        }

        .category-tabs button {
            min-height: 2.8rem;
            padding: 0.45rem 0.95rem;
            border: 2px solid var(--brand);
            border-radius: 999px;
            background: transparent;
            color: var(--brand);
            cursor: pointer;
        }

        .category-tabs button[aria-selected="true"] {
            background: var(--brand);
            color: var(--brand-ink);
        }

        .menu-status {
            min-height: 1.4rem;
            margin: 0;
            padding: 0 1.25rem;
            color: var(--muted);
        }

        .menu-status.error {
            color: var(--danger);
            font-weight: bold;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
            gap: 0.85rem;
            align-content: start;
            overflow: auto;
            padding: 0.75rem 1.25rem 1.25rem;
        }

        .drink-card {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.8rem;
            min-height: 7.2rem;
            padding: 1rem;
            border: 2px solid var(--line);
            border-radius: 1rem;
            background: var(--card);
            color: var(--ink);
            text-align: left;
            box-shadow: var(--shadow);
            cursor: pointer;
        }

        .drink-card:hover {
            border-color: var(--brand);
        }

        .drink-name {
            font-size: 1.05rem;
            font-weight: bold;
            line-height: 1.25;
        }

        .drink-price {
            font-size: 1rem;
            color: var(--brand);
        }

        .cart-panel {
            border-left: 2px solid var(--line);
            background: var(--sidebar);
            padding: 1rem 1.1rem 1.15rem;
        }

        .cart-items {
            flex: 1;
            overflow: auto;
            margin: 0.8rem 0;
            padding: 0;
            list-style: none;
        }

        .cart-empty {
            margin: 0.4rem 0 0;
            color: var(--muted);
        }

        .cart-row {
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--line);
        }

        .cart-row-top {
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .line-total {
            font-weight: bold;
            white-space: nowrap;
        }

        .cart-controls {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            margin-top: 0.55rem;
        }

        .qty-btn,
        .remove-btn,
        .primary-btn,
        .secondary-btn {
            min-height: 2.7rem;
            border-radius: 0.7rem;
            cursor: pointer;
        }

        .qty-btn,
        .remove-btn,
        .secondary-btn {
            border: 2px solid var(--brand);
            background: transparent;
            color: var(--brand);
        }

        .qty-btn {
            width: 2.7rem;
            font-size: 1.2rem;
        }

        .remove-btn,
        .secondary-btn,
        .primary-btn {
            padding: 0.4rem 0.8rem;
        }

        .qty {
            min-width: 1.4rem;
            text-align: center;
            font-weight: bold;
        }

        .cart-footer {
            border-top: 2px solid var(--line);
            padding-top: 0.85rem;
        }

        .totals {
            margin: 0 0 0.9rem;
        }

        .totals div {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin: 0.25rem 0;
        }

        .totals dt {
            color: var(--muted);
        }

        .totals dd {
            margin: 0;
            font-weight: bold;
        }

        .grand-total dt,
        .grand-total dd {
            color: var(--ink);
            font-size: 1.25rem;
        }

        label {
            display: block;
            margin-bottom: 0.35rem;
            font-weight: bold;
        }

        input[type="text"] {
            width: 100%;
            min-height: 2.8rem;
            margin-bottom: 0.8rem;
            padding: 0.45rem 0.7rem;
            border: 2px solid var(--line);
            border-radius: 0.7rem;
            background: #fff;
            color: var(--ink);
        }

        .primary-btn {
            width: 100%;
            border: 2px solid var(--brand);
            background: var(--brand);
            color: var(--brand-ink);
            font-weight: bold;
        }

        .primary-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .form-status {
            min-height: 1.3rem;
            margin: 0.55rem 0 0;
            color: var(--danger);
            font-weight: bold;
        }

        .form-status.ok {
            color: var(--ok);
        }

        .confirmation h2 {
            margin-bottom: 0.6rem;
        }

        .confirmation p {
            font-size: 1.1rem;
            line-height: 1.4;
        }

        html.high-contrast {
            --bg: #000;
            --ink: #fff;
            --muted: #fff;
            --card: #000;
            --line: #fff;
            --brand: #ffd400;
            --brand-ink: #000;
            --sidebar: #000;
            --focus: #ffd400;
            --danger: #ffb4b4;
            --ok: #b8ffcf;
            --shadow: none;
        }

        html.high-contrast .kiosk-header {
            background: #000;
            color: #fff;
            border-bottom: 3px solid #fff;
        }

        html.high-contrast .a11y-controls a,
        html.high-contrast .a11y-controls button,
        html.high-contrast .drink-card,
        html.high-contrast input[type="text"] {
            background: #000;
            color: #fff;
            border-color: #fff;
        }

        html.high-contrast .a11y-controls button[aria-pressed="true"],
        html.high-contrast .category-tabs button[aria-selected="true"],
        html.high-contrast .primary-btn {
            background: #ffd400;
            color: #000;
            border-color: #ffd400;
        }

        html.high-contrast .drink-price,
        html.high-contrast .qty-btn,
        html.high-contrast .remove-btn,
        html.high-contrast .secondary-btn,
        html.high-contrast .category-tabs button {
            color: #ffd400;
            border-color: #ffd400;
        }

        @media (max-width: 900px) {
            body {
                height: auto;
                min-height: 100vh;
                overflow: auto;
            }

            .kiosk-main {
                grid-template-columns: 1fr;
            }

            .menu-grid,
            .cart-items {
                overflow: visible;
            }

            .cart-panel {
                border-left: 0;
                border-top: 2px solid var(--line);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                scroll-behavior: auto;
                transition: none;
            }
        }
    </style>
</head>
<body>
    <header class="kiosk-header">
        <div>
            <p class="eyebrow">Lobby self-service</p>
            <h1>Quality Boba</h1>
        </div>
        <div class="a11y-controls">
            <a href="/">Portal</a>
            <button type="button" id="large-text-btn" aria-pressed="false">Large text</button>
            <button type="button" id="contrast-btn" aria-pressed="false">High contrast</button>
        </div>
    </header>

    <main class="kiosk-main">
        <section class="menu-panel" aria-labelledby="menu-heading">
