<!DOCTYPE html>
<html lang="en" data-page="kiosk">
<head>
    <%- include('partials/head', { page: 'kiosk', pageTitle: "Customer Kiosk - Quality Boba" }) %>
</head>
<body>
    <header class="kiosk-header">
        <div class="brand">
            <span class="logo" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="38" height="38">
                    <rect width="48" height="48" rx="14" fill="#F3E6D4"/>
                    <path d="M15 15 L18 34 Q19 37 23 37 H25 Q29 37 30 34 L33 15 Z" fill="#E8C9A0"/>
                    <path d="M16.5 21 H31.5 L29.5 34 Q28.6 36 25 36 H23 Q19.4 36 18.5 34 Z" fill="#C68642"/>
                    <circle cx="21" cy="31.5" r="2.1" fill="#241C18"/>
                    <circle cx="26.2" cy="32.4" r="2.1" fill="#241C18"/>
                    <ellipse cx="24" cy="15" rx="10" ry="2.4" fill="#FFF8F1"/>
                    <rect x="30" y="6" width="2.4" height="12" rx="1.2" fill="#F6EFE4" transform="rotate(18 31 12)"/>
                </svg>
            </span>
            <div>
                <h1>Quality Boba</h1>
                <p>Tap to order</p>
            </div>
        </div>
        <p id="points-label" class="points-label" hidden>Current points: <span id="current-points">0</span></p>
        <div class="a11y-controls">
            <button type="button" id="chat-open" aria-haspopup="dialog" aria-controls="drink-chat" aria-expanded="false">Ask about drinks</button>
            <a href="/">Exit</a>
            <button type="button" id="large-text-btn" aria-pressed="false">Large text</button>
            <button type="button" id="contrast-btn" aria-pressed="false">High contrast</button>
        </div>
    </header>

    <div id="check-in" class="gate-screen">
        <form id="check-in-form" class="gate-card">
            <h2>Check in</h2>
            <p class="checkout-copy">Enter your 4-digit code.</p>
            <label for="customer-code">Code</label>
            <input id="customer-code" name="customer_id" type="text" inputmode="numeric" maxlength="4" autocomplete="off" required>
            <p id="check-in-status" class="form-status" role="status"></p>
            <div class="gate-actions">
                <button type="submit" class="primary-btn" id="check-in-submit" disabled>Continue</button>
                <button type="button" class="secondary-btn" id="skip-code">I don't have a code</button>
            </div>
        </form>
    </div>

    <div id="checked-in" class="gate-screen" hidden>
        <h2 id="checked-in-line" class="checked-in-line" tabindex="-1">You've checked in</h2>
    </div>

    <div id="welcome" class="gate-screen" hidden>
        <div class="gate-card">
            <h2 id="welcome-title">Welcome</h2>
            <p id="welcome-points"></p>
            <button type="button" class="primary-btn" id="welcome-continue">Start order</button>
        </div>
    </div>

    <div class="kiosk-shell" hidden>
        <nav class="category-tabs" role="tablist" aria-label="Drink categories">
            <button type="button" role="tab" id="tab-milk" data-category="Milk Tea" aria-selected="true" aria-controls="menu-grid">
                <img src="/images/menu/classic-milk-tea.svg" alt="">
                <span>Milk Tea</span>
            </button>
            <button type="button" role="tab" id="tab-fruit" data-category="Fruit Tea" aria-selected="false" aria-controls="menu-grid" tabindex="-1">
                <img src="/images/menu/mango-green-tea.svg" alt="">
                <span>Fruit Tea</span>
            </button>
            <button type="button" role="tab" id="tab-specialty" data-category="Specialty" aria-selected="false" aria-controls="menu-grid" tabindex="-1">
                <img src="/images/menu/matcha-latte.svg" alt="">
                <span>Specialty</span>
            </button>
        </nav>

        <section class="menu-panel" aria-labelledby="menu-heading">
            <div class="menu-intro">
                <h2 id="menu-heading">Milk Tea</h2>
                <p id="menu-status" class="menu-status" role="status">Loading drinks...</p>
            </div>
            <div id="menu-grid" class="menu-grid" role="tabpanel" aria-labelledby="tab-milk"></div>
        </section>

        <aside class="bag" aria-labelledby="cart-heading">
            <div id="order-view" class="order-view">
                <div class="bag-head">
                    <h2 id="cart-heading">Your order</h2>
                    <span id="bag-count" class="bag-count" hidden>0</span>
                </div>
                <div class="bag-body">
                    <div id="cart-empty" class="cart-empty">
                        <img src="/images/menu/signature-drink.svg" alt="">
                        <p>Tap a drink to start your order.</p>
                    </div>
                    <ul id="cart-items" class="cart-items" aria-label="Selected drinks"></ul>
                </div>
                <section id="redeem" class="redeem" hidden aria-labelledby="redeem-heading">
                    <h3 id="redeem-heading">Redeem points</h3>
                    <div id="reward-list" class="reward-list"></div>
                </section>
                <div class="bag-footer">
                    <dl class="totals">
                        <div>
                            <dt>Subtotal</dt>
                            <dd id="subtotal">$0.00</dd>
                        </div>
                        <div id="reward-row" hidden>
                            <dt>Reward</dt>
                            <dd id="reward-amount">-$0.00</dd>
                        </div>
                        <div>
                            <dt>Tax (8.25%)</dt>
                            <dd id="tax">$0.00</dd>
                        </div>
                    </dl>
                    <button type="button" class="checkout-btn" id="checkout-btn" disabled>
                        <span id="checkout-label">Add a drink</span>
                        <span id="checkout-total" hidden>$0.00</span>
                    </button>
                </div>
            </div>
        </aside>
    </div>

    <div id="checkout-sheet" class="checkout-sheet" hidden>
        <div class="checkout-card" role="dialog" aria-modal="true" aria-labelledby="checkout-title">
            <form id="order-form">
                <h2 id="checkout-title">Name for the order</h2>
                <p class="checkout-copy">We'll call this name when the drinks are ready.</p>
                <label for="customer-name">Name</label>
                <input id="customer-name" name="customer_name" type="text" maxlength="80" autocomplete="name" required>
                <p id="form-status" class="form-status" role="status"></p>
                <div class="checkout-actions">
                    <button type="button" class="secondary-btn" id="checkout-back">Back</button>
                    <button type="submit" class="primary-btn" id="place-order-btn" disabled>Place order</button>
                </div>
            </form>
        </div>
    </div>

    <div id="confirmation" class="confirm-screen" hidden>
        <p class="confirm-kicker">Order sent</p>
        <p id="confirmation-number" class="order-number"></p>
        <h2>We'll start on it now</h2>
        <p id="confirmation-message"></p>
        <button type="button" class="primary-btn" id="new-order-btn">Start new order</button>
    </div>
    <p id="cart-status" class="visually-hidden" role="status"></p>

    <dialog id="drink-chat" class="chat-dialog" aria-labelledby="chat-title" aria-describedby="chat-description">
        <div class="chat-head">
            <div>
                <h2 id="chat-title">Your drink guide</h2>
                <p id="chat-description">AI help with drinks and ordering. Please confirm allergies with staff.</p>
            </div>
            <button type="button" id="chat-close" aria-label="Close drink assistant">Close</button>
        </div>
        <div id="chat-messages" class="chat-messages" role="log" aria-label="Drink assistant conversation" aria-live="polite" aria-relevant="additions text"></div>
        <p id="chat-status" class="chat-status" role="status"></p>
        <form id="chat-form" class="chat-form">
            <label for="chat-input">Ask about drinks, ingredients, or ordering</label>
            <div class="chat-compose">
                <textarea id="chat-input" rows="2" maxlength="1000" placeholder="What would you recommend?" required></textarea>
                <button id="chat-send" type="submit">Send</button>
            </div>
            <button id="chat-reset" class="chat-reset" type="button">Start a new chat</button>
        </form>
    </dialog>

    <script src="/js/shared/money.js"></script>
    <script src="/js/shared/menu.js"></script>
    <script src="/js/shared/rewards.js"></script>
    <script src="/js/vendor/markdown-it.min.js"></script>
    <script src="/js/components/chat-markdown.js"></script>
    <script src="/js/components/kiosk-chat.js"></script>
    <script src="/js/pages/kiosk.js"></script>
</body>
</html>
