            <article class="drink-card" data-id="14" data-price="5.50" data-category="Fruit Tea" hidden>
                <span class="drink-name">Lemon Green Tea</span>
                <span class="drink-price">$5.50</span>
            </article>
            <article class="drink-card" data-id="15" data-price="5.50" data-category="Fruit Tea" hidden>
                <span class="drink-name">Honey Green Tea</span>
