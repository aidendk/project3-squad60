<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Kiosk - Quality Boba</title>
    <style>
        :root {
            --bg: #f3ece3;
            --ink: #24180f;
            --muted: #5e4b3c;
            --card: #fffdf9;
            --line: #e3d5c4;
            --brand: #4e2c1c;
            --brand-ink: #fffdf9;
            --sidebar: #fffaf5;
            --focus: #0b57d0;
            --danger: #8d1d1d;
            --ok: #0f6b3c;
            --shadow: 0 10px 28px rgba(62, 36, 18, 0.08);
        }

        html {
            font-size: 18px;
        }

        html.large-text {
            font-size: 23px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            height: 100vh;
            display: grid;
            grid-template-rows: auto 1fr;
            overflow: hidden;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        button,
        input {
            font: inherit;
        }

        :focus-visible {
            outline: 3px solid var(--focus);
            outline-offset: 3px;
        }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .kiosk-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.75rem 1.25rem;
            background: var(--brand);
            color: var(--brand-ink);
        }

        .eyebrow {
            margin: 0;
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            font-size: 1.6rem;
            line-height: 1.1;
        }

        .a11y-controls {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 0.6rem;
        }

        .a11y-controls a,
        .a11y-controls button {
            min-height: 2.7rem;
            padding: 0.45rem 0.9rem;
            border: 2px solid #fffdf9;
            border-radius: 999px;
            background: transparent;
            color: #fffdf9;
            text-decoration: none;
            cursor: pointer;
        }

        .a11y-controls button[aria-pressed="true"] {
            background: #fffdf9;
            color: var(--brand);
        }

        .kiosk-main {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 23rem;
            min-height: 0;
        }

        .menu-panel,
        .cart-panel {
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .menu-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.9rem 1.25rem 0.4rem;
        }

        h2 {
            margin: 0;
            font-size: 1.25rem;
        }

        .category-tabs {
            display: flex;
            gap: 0.5rem;
        }

        .category-tabs button {
            min-height: 2.8rem;
            padding: 0.45rem 0.95rem;
            border: 2px solid var(--brand);
            border-radius: 999px;
            background: transparent;
            color: var(--brand);
            cursor: pointer;
        }

        .category-tabs button[aria-selected="true"] {
            background: var(--brand);
            color: var(--brand-ink);
        }

        .menu-status {
            min-height: 1.4rem;
            margin: 0;
            padding: 0 1.25rem;
            color: var(--muted);
        }

        .menu-status.error {
            color: var(--danger);
            font-weight: bold;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
            gap: 0.85rem;
            align-content: start;
            overflow: auto;
            padding: 0.75rem 1.25rem 1.25rem;
        }

        .drink-card {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.8rem;
            min-height: 7.2rem;
            padding: 1rem;
            border: 2px solid var(--line);
            border-radius: 1rem;
            background: var(--card);
            color: var(--ink);
            width: 100%;
            text-align: left;
            box-shadow: var(--shadow);
            cursor: pointer;
        }

        .drink-card:hover {
            border-color: var(--brand);
        }

        .drink-name {
            font-size: 1.05rem;
            font-weight: bold;
            line-height: 1.25;
        }

        .drink-price {
            font-size: 1rem;
            color: var(--brand);
        }

        .cart-panel {
            border-left: 2px solid var(--line);
            background: var(--sidebar);
            padding: 1rem 1.1rem 1.15rem;
        }

        .cart-items {
            flex: 1;
            overflow: auto;
            margin: 0.8rem 0;
            padding: 0;
            list-style: none;
        }

        .cart-empty {
            margin: 0.4rem 0 0;
            color: var(--muted);
        }

        .cart-row {
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--line);
        }

        .cart-row-top {
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .line-total {
            font-weight: bold;
            white-space: nowrap;
        }

        .cart-controls {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            margin-top: 0.55rem;
        }

        .qty-btn,
        .remove-btn,
        .primary-btn,
        .secondary-btn {
            min-height: 2.7rem;
            border-radius: 0.7rem;
            cursor: pointer;
        }

        .qty-btn,
        .remove-btn,
        .secondary-btn {
            border: 2px solid var(--brand);
            background: transparent;
            color: var(--brand);
        }

        .qty-btn {
            width: 2.7rem;
            font-size: 1.2rem;
        }

        .remove-btn,
        .secondary-btn,
        .primary-btn {
            padding: 0.4rem 0.8rem;
        }

        .qty {
            min-width: 1.4rem;
            text-align: center;
            font-weight: bold;
        }

        .cart-footer {
            border-top: 2px solid var(--line);
            padding-top: 0.85rem;
        }

        .totals {
            margin: 0 0 0.9rem;
        }

        .totals div {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin: 0.25rem 0;
        }

        .totals dt {
            color: var(--muted);
        }

        .totals dd {
            margin: 0;
            font-weight: bold;
        }

        .grand-total dt,
        .grand-total dd {
            color: var(--ink);
            font-size: 1.25rem;
        }

        label {
            display: block;
            margin-bottom: 0.35rem;
            font-weight: bold;
        }

        input[type="text"] {
            width: 100%;
            min-height: 2.8rem;
            margin-bottom: 0.8rem;
            padding: 0.45rem 0.7rem;
            border: 2px solid var(--line);
            border-radius: 0.7rem;
            background: #fff;
            color: var(--ink);
        }

        .primary-btn {
            width: 100%;
            border: 2px solid var(--brand);
            background: var(--brand);
            color: var(--brand-ink);
            font-weight: bold;
        }

        .primary-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .form-status {
            min-height: 1.3rem;
            margin: 0.55rem 0 0;
            color: var(--danger);
            font-weight: bold;
        }

        .form-status.ok {
            color: var(--ok);
        }

        .confirmation h2 {
            margin-bottom: 0.6rem;
        }

        .confirmation p {
            font-size: 1.1rem;
            line-height: 1.4;
        }

        html.high-contrast {
            --bg: #000;
            --ink: #fff;
            --muted: #fff;
            --card: #000;
            --line: #fff;
            --brand: #ffd400;
            --brand-ink: #000;
            --sidebar: #000;
            --focus: #ffd400;
            --danger: #ffb4b4;
            --ok: #b8ffcf;
            --shadow: none;
        }

        html.high-contrast .kiosk-header {
            background: #000;
            color: #fff;
            border-bottom: 3px solid #fff;
        }

        html.high-contrast .a11y-controls a,
        html.high-contrast .a11y-controls button,
        html.high-contrast .drink-card,
        html.high-contrast input[type="text"] {
            background: #000;
            color: #fff;
            border-color: #fff;
        }

        html.high-contrast .a11y-controls button[aria-pressed="true"],
        html.high-contrast .category-tabs button[aria-selected="true"],
        html.high-contrast .primary-btn {
            background: #ffd400;
            color: #000;
            border-color: #ffd400;
        }

        html.high-contrast .drink-price,
        html.high-contrast .qty-btn,
        html.high-contrast .remove-btn,
        html.high-contrast .secondary-btn,
        html.high-contrast .category-tabs button {
            color: #ffd400;
            border-color: #ffd400;
        }

        @media (max-width: 900px) {
            body {
                height: auto;
                min-height: 100vh;
                overflow: auto;
            }

            .kiosk-main {
                grid-template-columns: 1fr;
            }

            .menu-grid,
            .cart-items {
                overflow: visible;
            }

            .cart-panel {
                border-left: 0;
                border-top: 2px solid var(--line);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                scroll-behavior: auto;
                transition: none;
            }
        }
    </style>
</head>
<body>
    <header class="kiosk-header">
        <div>
            <p class="eyebrow">Lobby self-service</p>
            <h1>Quality Boba</h1>
        </div>
        <div class="a11y-controls">
            <a href="/">Portal</a>
            <button type="button" id="large-text-btn" aria-pressed="false">Large text</button>
            <button type="button" id="contrast-btn" aria-pressed="false">High contrast</button>
        </div>
    </header>

    <main class="kiosk-main">
        <section class="menu-panel" aria-labelledby="menu-heading">
            <div class="menu-toolbar">
                <h2 id="menu-heading">Menu</h2>
                <div class="category-tabs" role="tablist" aria-label="Drink categories">
                    <button type="button" role="tab" id="tab-milk" data-category="Milk Tea" aria-selected="true" aria-controls="menu-grid">Milk Tea</button>
                    <button type="button" role="tab" id="tab-fruit" data-category="Fruit Tea" aria-selected="false" aria-controls="menu-grid" tabindex="-1">Fruit Tea</button>
                    <button type="button" role="tab" id="tab-specialty" data-category="Specialty" aria-selected="false" aria-controls="menu-grid" tabindex="-1">Specialty</button>
                </div>
            </div>
            <p id="menu-status" class="menu-status" role="status">Loading drinks...</p>
            <div id="menu-grid" class="menu-grid" role="tabpanel" aria-labelledby="tab-milk"></div>
        </section>

        <aside class="cart-panel" aria-labelledby="cart-heading">
            <div id="order-view">
                <h2 id="cart-heading">Your order</h2>
                <p id="cart-empty" class="cart-empty">Tap a drink to add it.</p>
                <ul id="cart-items" class="cart-items" aria-label="Selected drinks"></ul>
                <div class="cart-footer">
                    <dl class="totals">
                        <div>
                            <dt>Subtotal</dt>
                            <dd id="subtotal">$0.00</dd>
                        </div>
                        <div>
                            <dt>Tax (8.25%)</dt>
                            <dd id="tax">$0.00</dd>
                        </div>
                        <div class="grand-total">
                            <dt>Total</dt>
                            <dd id="total">$0.00</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </aside>
    </main>
    <p id="cart-status" class="visually-hidden" role="status"></p>

    <script>
        const menuGrid = document.getElementById('menu-grid');
        const menuStatus = document.getElementById('menu-status');
        const tablist = document.querySelector('.category-tabs');
        const tabs = [...tablist.querySelectorAll('[role="tab"]')];
        const largeTextBtn = document.getElementById('large-text-btn');
        const contrastBtn = document.getElementById('contrast-btn');
        const TOPPINGS = new Set([
            'tapioca pearls',
            'mango popping boba',
            'grass jelly',
            'aloe vera',
            'egg pudding',
            'red bean',
            'lychee jelly',
            'cheese foam'
        ]);
        let activeCategory = 'Milk Tea';
        let menuDrinks = [];

        function categoryFor(name) {
            const normalized = name.trim().toLowerCase();
            if (TOPPINGS.has(normalized)) {
                return null;
            }
            if (normalized.includes('milk tea')) {
                return 'Milk Tea';
            }
            if (normalized.includes('tea')) {
                return 'Fruit Tea';
            }
            return 'Specialty';
        }

        function selectCategory(category) {
            activeCategory = category;
            tabs.forEach((tab) => {
                const selected = tab.dataset.category === category;
                tab.setAttribute('aria-selected', selected ? 'true' : 'false');
                tab.tabIndex = selected ? 0 : -1;
                if (selected) {
                    menuGrid.setAttribute('aria-labelledby', tab.id);
                }
            });
            renderMenu();
        }

        function setPressed(button, storageKey, className, enabled) {
            document.documentElement.classList.toggle(className, enabled);
            button.setAttribute('aria-pressed', enabled ? 'true' : 'false');
            sessionStorage.setItem(storageKey, enabled ? 'on' : 'off');
        }

        tablist.addEventListener('click', (event) => {
            const tab = event.target.closest('[role="tab"]');
            if (!tab) {
                return;
            }
            selectCategory(tab.dataset.category);
        });

        tablist.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') {
                return;
            }
            const index = tabs.indexOf(document.activeElement);
            if (index === -1) {
                return;
            }
            event.preventDefault();
            const nextIndex = event.key === 'ArrowRight'
                ? (index + 1) % tabs.length
                : (index - 1 + tabs.length) % tabs.length;
            tabs[nextIndex].focus();
            selectCategory(tabs[nextIndex].dataset.category);
        });

        largeTextBtn.addEventListener('click', () => {
            const enabled = largeTextBtn.getAttribute('aria-pressed') !== 'true';
            setPressed(largeTextBtn, 'kiosk-large-text', 'large-text', enabled);
        });

        contrastBtn.addEventListener('click', () => {
            const enabled = contrastBtn.getAttribute('aria-pressed') !== 'true';
            setPressed(contrastBtn, 'kiosk-contrast', 'high-contrast', enabled);
        });

        if (sessionStorage.getItem('kiosk-large-text') === 'on') {
            setPressed(largeTextBtn, 'kiosk-large-text', 'large-text', true);
        }
        if (sessionStorage.getItem('kiosk-contrast') === 'on') {
            setPressed(contrastBtn, 'kiosk-contrast', 'high-contrast', true);
        }

        const TAX_RATE = 0.0825;
        const cartItems = document.getElementById('cart-items');
        const cartEmpty = document.getElementById('cart-empty');
        const cartStatus = document.getElementById('cart-status');
        const subtotalEl = document.getElementById('subtotal');
        const taxEl = document.getElementById('tax');
        const totalEl = document.getElementById('total');
        const cart = new Map();

        function roundMoney(value) {
            return Math.round((Number(value) + Number.EPSILON) * 100) / 100;
        }

        function formatMoney(amount) {
            return `$${Number(amount).toFixed(2)}`;
        }

        function cartTotals() {
            const subtotal = roundMoney(
                [...cart.values()].reduce((sum, item) => sum + item.price * item.quantity, 0)
            );
            const tax = roundMoney(subtotal * TAX_RATE);
            return { subtotal, tax, total: roundMoney(subtotal + tax) };
        }

        function renderCart() {
            cartItems.replaceChildren();
            const totals = cartTotals();
            cartEmpty.hidden = cart.size > 0;
            subtotalEl.textContent = formatMoney(totals.subtotal);
            taxEl.textContent = formatMoney(totals.tax);
            totalEl.textContent = formatMoney(totals.total);

            cart.forEach((item) => {
                const row = document.createElement('li');
                row.className = 'cart-row';

                const top = document.createElement('div');
                top.className = 'cart-row-top';
                const name = document.createElement('span');
                name.textContent = item.name;
                const lineTotal = document.createElement('span');
                lineTotal.className = 'line-total';
                lineTotal.textContent = formatMoney(item.price * item.quantity);
                top.append(name, lineTotal);

                const controls = document.createElement('div');
                controls.className = 'cart-controls';

                const decrease = document.createElement('button');
                decrease.type = 'button';
                decrease.className = 'qty-btn';
                decrease.textContent = '−';
                decrease.setAttribute('aria-label', `Decrease ${item.name}`);
                decrease.addEventListener('click', () => changeQuantity(item.menu_item_id, -1));

                const qty = document.createElement('span');
                qty.className = 'qty';
                qty.textContent = String(item.quantity);

                const increase = document.createElement('button');
                increase.type = 'button';
                increase.className = 'qty-btn';
                increase.textContent = '+';
                increase.setAttribute('aria-label', `Increase ${item.name}`);
                increase.disabled = item.quantity >= 20;
                increase.addEventListener('click', () => changeQuantity(item.menu_item_id, 1));

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'remove-btn';
                remove.textContent = 'Remove';
                remove.setAttribute('aria-label', `Remove ${item.name}`);
                remove.addEventListener('click', () => {
                    cart.delete(item.menu_item_id);
                    cartStatus.textContent = `Removed ${item.name}. Total ${formatMoney(cartTotals().total)}.`;
                    renderCart();
                });

                controls.append(decrease, qty, increase, remove);
                row.append(top, controls);
                cartItems.append(row);
            });
        }

        function changeQuantity(menuItemId, delta) {
            const item = cart.get(menuItemId);
            if (!item) {
                return;
            }
            const nextQuantity = item.quantity + delta;
            if (nextQuantity <= 0) {
                cart.delete(menuItemId);
                cartStatus.textContent = `Removed ${item.name}. Total ${formatMoney(cartTotals().total)}.`;
            } else if (nextQuantity <= 20) {
                item.quantity = nextQuantity;
                cartStatus.textContent = `${item.name} quantity ${item.quantity}. Total ${formatMoney(cartTotals().total)}.`;
            }
            renderCart();
        }

        function addToCart(drink) {
            const existing = cart.get(drink.menu_item_id);
            if (existing) {
                if (existing.quantity >= 20) {
                    cartStatus.textContent = `You can add up to 20 of each drink.`;
                    return;
                }
                existing.quantity += 1;
            } else {
                cart.set(drink.menu_item_id, {
                    menu_item_id: drink.menu_item_id,
                    name: drink.name,
                    price: drink.price,
                    quantity: 1
                });
            }
            cartStatus.textContent = `Added ${drink.name}. Total ${formatMoney(cartTotals().total)}.`;
            renderCart();
        }

        function renderMenu() {
            menuGrid.replaceChildren();
            const visibleDrinks = menuDrinks
                .filter((drink) => drink.category === activeCategory)
                .sort((a, b) => a.name.localeCompare(b.name));

            if (visibleDrinks.length === 0) {
                menuStatus.textContent = menuDrinks.length === 0
                    ? menuStatus.textContent
                    : 'No drinks in this category.';
                return;
            }

            menuStatus.textContent = `${visibleDrinks.length} drinks`;
            visibleDrinks.forEach((drink) => {
                const card = document.createElement('button');
                card.type = 'button';
                card.className = 'drink-card';
                card.dataset.id = String(drink.menu_item_id);
                card.dataset.price = drink.price.toFixed(2);
                card.dataset.category = drink.category;
                card.setAttribute('aria-label', `Add ${drink.name}, ${formatMoney(drink.price)}`);

                const name = document.createElement('span');
                name.className = 'drink-name';
                name.textContent = drink.name;

                const price = document.createElement('span');
                price.className = 'drink-price';
                price.textContent = formatMoney(drink.price);

                card.append(name, price);
                menuGrid.append(card);
            });
        }

        async function loadMenu() {
            menuStatus.textContent = 'Loading drinks...';
            menuStatus.classList.remove('error');
            try {
                const response = await fetch('/api/menu');
                if (!response.ok) {
                    throw new Error('Menu request failed');
                }
                const menu = await response.json();
                menuDrinks = menu
                    .map((item) => ({
                        menu_item_id: item.menu_item_id,
                        name: item.name,
                        price: Number(item.price),
                        category: categoryFor(item.name)
                    }))
                    .filter((item) => item.category);
                renderMenu();
            } catch (err) {
                menuDrinks = [];
                menuGrid.replaceChildren();
                menuStatus.textContent = 'The menu could not be loaded. Please try again.';
                menuStatus.classList.add('error');
            }
        }

        menuGrid.addEventListener('click', (event) => {
            const card = event.target.closest('.drink-card');
            if (!card) {
                return;
            }
            addToCart({
                menu_item_id: Number(card.dataset.id),
                name: card.querySelector('.drink-name').textContent,
                price: Number(card.dataset.price)
            });
        });

        renderCart();
        loadMenu();

    </script>
</body>
</html>
