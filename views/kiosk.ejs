                    <button type="button" role="tab" id="tab-fruit" data-category="Fruit Tea" aria-selected="false" aria-controls="menu-grid" tabindex="-1">Fruit Tea</button>
                    <button type="button" role="tab" id="tab-specialty" data-category="Specialty" aria-selected="false" aria-controls="menu-grid" tabindex="-1">Specialty</button>
                </div>
            </div>
            <p id="menu-status" class="menu-status" role="status">11 drinks</p>
