            </article>
            <article class="drink-card" data-id="12" data-price="6.25" data-category="Fruit Tea" hidden>
                <span class="drink-name">Passion Fruit Green Tea</span>
                <span class="drink-price">$6.25</span>
            </article>
            <article class="drink-card" data-id="13" data-price="6.00" data-category="Fruit Tea" hidden>
                <span class="drink-name">Lychee Black Tea</span>
