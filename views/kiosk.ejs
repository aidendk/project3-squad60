                <span class="drink-price">$5.75</span>
            </article>
            <article class="drink-card" data-id="2" data-price="6.25" data-category="Milk Tea">
                <span class="drink-name">Taro Milk Tea</span>
                <span class="drink-price">$6.25</span>
            </article>
            <article class="drink-card" data-id="3" data-price="6.25" data-category="Milk Tea">
                <span class="drink-name">Thai Milk Tea</span>
                <span class="drink-price">$6.25</span>
            </article>
            <article class="drink-card" data-id="4" data-price="6.50" data-category="Milk Tea">
                <span class="drink-name">Brown Sugar Milk Tea</span>
                <span class="drink-price">$6.50</span>
            </article>
            <article class="drink-card" data-id="5" data-price="6.50" data-category="Milk Tea">
                <span class="drink-name">Matcha Milk Tea</span>
                <span class="drink-price">$6.50</span>
            </article>
            <article class="drink-card" data-id="6" data-price="5.75" data-category="Milk Tea">
                <span class="drink-name">Jasmine Green Milk Tea</span>
                <span class="drink-price">$5.75</span>
            </article>
            <article class="drink-card" data-id="7" data-price="6.00" data-category="Milk Tea">
                <span class="drink-name">Oolong Milk Tea</span>
                <span class="drink-price">$6.00</span>
            </article>
            <article class="drink-card" data-id="8" data-price="6.00" data-category="Milk Tea">
                <span class="drink-name">Wintermelon Milk Tea</span>
                <span class="drink-price">$6.00</span>
            </article>
            <article class="drink-card" data-id="16" data-price="6.50" data-category="Milk Tea">
                <span class="drink-name">Coffee Milk Tea</span>
                <span class="drink-price">$6.50</span>
            </article>
            <article class="drink-card" data-id="17" data-price="6.50" data-category="Milk Tea">
                <span class="drink-name">Chocolate Milk Tea</span>
                <span class="drink-price">$6.50</span>
            </article>
            <article class="drink-card" data-id="18" data-price="6.25" data-category="Milk Tea">
                <span class="drink-name">Coconut Milk Tea</span>
                <span class="drink-price">$6.25</span>
            </article>
            <article class="drink-card" data-id="9" data-price="6.00" data-category="Fruit Tea" hidden>
                <span class="drink-name">Mango Green Tea</span>
                <span class="drink-price">$6.00</span>
            </article>
            <article class="drink-card" data-id="10" data-price="6.00" data-category="Fruit Tea" hidden>
                <span class="drink-name">Strawberry Green Tea</span>
                <span class="drink-price">$6.00</span>
            </article>
            <article class="drink-card" data-id="11" data-price="6.00" data-category="Fruit Tea" hidden>
                <span class="drink-name">Peach Oolong Tea</span>
