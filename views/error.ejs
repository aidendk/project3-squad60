<!DOCTYPE html>
<html lang="en" data-page="error">
<head>
    <%- include('partials/head', { page: 'error', pageTitle: statusCode + ' | Quality Boba' }) %>
</head>

<body>
    <header style="display: flex; justify-content: space-between; align-items: center;">
        <span>Quality Boba &bull; Squad 60</span>
        <button type="button" id="contrast-toggle-btn" class="contrast-toggle-btn" aria-pressed="false" aria-label="Toggle High Contrast Mode">
            <span aria-hidden="true">👁️</span> Contrast: <strong class="contrast-state-text">Off</strong>
        </button>
    </header>

    <main>
        <p class="error-code">Error <%= statusCode %></p>
        <h1><%= title %></h1>
        <p><%= message %></p>
        <a href="/">Return to Portal</a>
    </main>
</body>
</html>
