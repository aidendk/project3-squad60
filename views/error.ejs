<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= statusCode %> | Quality Boba</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3ece2;
            color: #2b2118;
            font-family: Arial, sans-serif;
        }

        header {
            padding: 24px;
            background: #542f1d;
            color: #fffdf9;
            font-size: 1.5rem;
            font-weight: bold;
        }

        main {
            max-width: 600px;
            margin: 48px auto;
            padding: 32px;
            background: #fffdf9;
            border: 2px solid #e5d5c3;
            border-radius: 24px;
        }

        .error-code {
            color: #665343;
            font-weight: bold;
        }

        h1 {
            font-size: 2rem;
        }

        p {
            line-height: 1.6;
        }

        a {
            display: inline-block;
            margin-top: 16px;
            padding: 12px 20px;
            border-radius: 999px;
            background: #542f1d;
            color: #fffdf9;
            text-decoration: none;
            font-weight: bold;
        }

        a:hover {
            background: #70432b;
        }

        a:focus-visible {
            outline: 3px solid #542f1d;
            outline-offset: 5px;
        }

        @media (max-width: 650px) {
            main {
                margin: 24px 16px;
                padding: 24px;
            }
        }
    </style>
</head>

<body>
    <header>Quality Boba &bull; Squad 60</header>

    <main>
        <p class="error-code">Error <%= statusCode %></p>
        <h1><%= title %></h1>
        <p><%= message %></p>
        <a href="/">Return to Portal</a>
    </main>
</body>
</html>