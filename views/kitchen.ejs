<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Display - Quality Boba</title>
    <style>
        :root {
            --bg-main: #f4ece1;
            --bg-panel: #fffdf9;
            --bg-subtle: #fbf7f0;
            --border-color: #e3d5c4;
            --border-dark: #d5c2ab;
            --text-main: #24180f;
            --text-muted: #6b5747;
            --brand: #4e2c1c;
            --brand-dark: #3a2014;
            --brand-hover: #3d2215;
            --accent-green: #2e6f40;
            --accent-green-hover: #235632;
            --accent-green-light: #eaf3ec;
            --accent-caramel: #8b5032;
            --accent-amber-bg: #fff8eb;
            --accent-amber-border: #f2d199;
            --accent-amber-text: #8c5211;
            --danger: #a12828;
            --danger-bg: #fdf2f2;
            --shadow-sm: 0 4px 14px rgba(62, 36, 18, 0.06);
            --shadow-md: 0 8px 24px rgba(62, 36, 18, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background: var(--bg-main);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            flex-direction: column;
        }

        /* Top Brand Bar */
        .kitchen-header {
            background-color: var(--brand);
            border-bottom: 2px solid var(--brand-dark);
            padding: 12px 24px;
            color: #fffdf9;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        }

        .header-content {
            max-width: 1500px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            font-size: 1.8rem;
        }

        .brand-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #fffdf9;
            letter-spacing: -0.3px;
            margin: 0;
        }

        .brand-sub {
            font-size: 0.8rem;
            color: #e4d5c4;
            margin: 0;
        }

        .badge-role {
            background: rgba(255, 253, 249, 0.15);
            border: 1px solid rgba(255, 253, 249, 0.3);
            color: #fffdf9;
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        /* Main Board Container */
        .board {
            width: min(1500px, 100%);
            margin: 0 auto;
            padding: 28px clamp(18px, 4vw, 56px) 48px;
            flex: 1;
        }

        .board-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
        }

        h1 {
            font-size: clamp(1.8rem, 3vw, 2.3rem);
            letter-spacing: -0.03em;
            color: var(--brand);
            font-weight: 800;
        }

        .subtitle {
            color: var(--text-muted);
            margin-top: 5px;
            font-size: 0.95rem;
        }

        .last-updated {
            color: var(--text-muted);
            font-size: 0.85rem;
            text-align: right;
            background: var(--bg-panel);
            border: 1.5px solid var(--border-color);
            padding: 6px 14px;
            border-radius: 999px;
            font-weight: 600;
        }

        /* Tickets Grid */
        .tickets {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
            align-items: start;
            gap: 20px;
        }

        /* Ticket Card */
        .ticket {
            overflow: hidden;
            background: var(--bg-panel);
            border: 1.5px solid var(--border-color);
            border-top: 4px solid var(--brand);
            border-radius: 14px;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
        }

        .ticket:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--border-dark);
        }

        .ticket-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding: 16px;
            background: var(--bg-subtle);
            border-bottom: 1px solid var(--border-color);
        }

        .order-number {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--brand);
        }

        .source {
            display: inline-block;
            margin-top: 6px;
            padding: 3px 8px;
            border-radius: 6px;
            background: #ede2d3;
            color: var(--brand);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: capitalize;
            border: 1px solid var(--border-color);
        }

        .elapsed {
            color: var(--accent-green);
            background: var(--accent-green-light);
            font-size: 0.82rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 12px;
            text-align: right;
            white-space: nowrap;
        }

        /* Items List */
        .items {
            list-style: none;
            margin: 0;
            padding: 8px 16px 16px;
        }

        .item {
            padding: 12px 0;
            border-bottom: 1px dashed var(--border-color);
        }

        .item:last-child {
            border-bottom: 0;
        }

        .item-name {
            display: flex;
            gap: 8px;
            font-weight: 700;
            line-height: 1.35;
            color: var(--text-main);
            font-size: 1rem;
        }

        .quantity {
            color: var(--accent-caramel);
            font-weight: 800;
            background: #f4ece1;
            padding: 2px 7px;
            border-radius: 5px;
            min-width: 20px;
            font-size: 0.88rem;
        }

        .customizations {
            display: grid;
            gap: 4px;
            margin: 8px 0 0 28px;
            color: var(--text-muted);
            font-size: 0.88rem;
        }

        .customization-label {
            color: var(--brand);
            font-weight: 600;
        }

        .instructions {
            margin: 8px 0 0 28px;
            color: var(--accent-amber-text);
            background: var(--accent-amber-bg);
            border: 1px solid var(--accent-amber-border);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-style: italic;
        }

        /* Footer & Mark Ready Button */
        .ticket-footer {
            padding: 0 16px 16px;
        }

        .mark-ready {
            width: 100%;
            padding: 12px 14px;
            border: 0;
            border-radius: 8px;
            background: var(--accent-green);
            color: #ffffff;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: 700;
            transition: all 0.15s ease;
        }

        .mark-ready:hover:not(:disabled) {
            background: var(--accent-green-hover);
            transform: translateY(-1px);
        }

        .mark-ready:focus-visible {
            outline: 3px solid var(--brand);
            outline-offset: 2px;
        }

        .mark-ready:disabled {
            cursor: wait;
            opacity: 0.65;
        }

        /* Empty & Error States */
        .empty, .error {
            grid-column: 1 / -1;
            padding: 48px 20px;
            border: 2px dashed var(--border-color);
            border-radius: 14px;
            color: var(--text-muted);
            text-align: center;
            background: var(--bg-panel);
            font-size: 1.05rem;
            font-weight: 600;
        }

        .error {
            color: var(--danger);
            border-color: #fca5a5;
            background: var(--danger-bg);
        }

        @media (max-width: 560px) {
            .board-header {
                align-items: flex-start;
                flex-direction: column;
            }
            .last-updated {
                text-align: left;
            }
        }
    </style>
</head>
<body>
    <header class="kitchen-header">
        <div class="header-content">
            <div class="brand-group">
                <span class="logo-icon">🧋</span>
                <div>
                    <h2 class="brand-title">Quality Boba</h2>
                    <p class="brand-sub">Squad 60 &bull; Kitchen Display System</p>
                </div>
            </div>
            <div class="badge-role">Barista Station</div>
        </div>
    </header>

    <main class="board">
        <header class="board-header">
            <div>
                <h1>Kitchen Display</h1>
                <p class="subtitle">Active orders ready to prepare</p>
            </div>
            <p class="last-updated" id="last-updated">Loading orders...</p>
        </header>

        <section class="tickets" id="tickets" aria-live="polite">
            <p class="empty">Loading orders...</p>
        </section>
    </main>

    <script>
        const tickets = document.getElementById('tickets');
        const lastUpdated = document.getElementById('last-updated');
        let orders = [];

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, (character) => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[character]));
        }

        function displayValue(value) {
            if (value === null || value === undefined || value === '') return '';
            if (typeof value === 'object') return Object.entries(value)
                .map(([key, item]) => `${key}: ${item}`)
                .join(', ');
            return String(value);
        }

        function customizationLines(customizations) {
            if (!customizations) return [];
            if (Array.isArray(customizations)) {
                return customizations.flatMap((customization) => {
                    if (typeof customization === 'object') {
                        return Object.entries(customization).map(([key, value]) => `${key}: ${displayValue(value)}`);
                    }
                    return [displayValue(customization)];
                });
            }
            if (typeof customizations === 'object') {
                return Object.entries(customizations).map(([key, value]) => `${key}: ${displayValue(value)}`);
            }
            return [displayValue(customizations)];
        }

        function orderItems(order) {
            if (Array.isArray(order.items)) return order.items;
            if (order.items && typeof order.items === 'object') return Object.values(order.items);
            return [];
        }

        function itemMarkup(item) {
            const itemObject = typeof item === 'object' && item !== null ? item : { name: item };
            const name = itemObject.name || itemObject.item_name || itemObject.menu_item_name || 'Unnamed item';
            const quantity = itemObject.quantity || itemObject.qty || 1;
            const customizations = customizationLines(itemObject.customizations || itemObject.modifications || itemObject.modifiers);
            const instructions = itemObject.special_instructions || itemObject.instructions || itemObject.note;
            const customizationsMarkup = customizations.length
                ? `<div class="customizations">${customizations.map((line) => `<span><span class="customization-label">${escapeHtml(line.split(':')[0])}${line.includes(':') ? ':' : ''}</span>${line.includes(':') ? ` ${escapeHtml(line.slice(line.indexOf(':') + 1).trim())}` : ''}</span>`).join('')}</div>`
                : '';
            const instructionsMarkup = instructions
                ? `<p class="instructions">Note: ${escapeHtml(instructions)}</p>`
                : '';

            return `<li class="item">
                <div class="item-name"><span class="quantity">${escapeHtml(quantity)}×</span><span>${escapeHtml(name)}</span></div>
                ${customizationsMarkup}
                ${instructionsMarkup}
            </li>`;
        }

        function elapsedTime(timestamp) {
            const created = new Date(timestamp);
            if (Number.isNaN(created.getTime())) return 'Time unavailable';
            const minutes = Math.max(0, Math.floor((Date.now() - created.getTime()) / 60000));
            if (minutes < 1) return 'Just now';
            if (minutes === 1) return '1 min ago';
            return `${minutes} min ago`;
        }

        function ticketMarkup(order) {
            const items = orderItems(order);
            const source = order.source || 'Unknown';
            const timestamp = order.timestamp || order.created_at;
            const orderId = order.order_id ?? order.id;
            return `<article class="ticket">
                <header class="ticket-header">
                    <div>
                        <h2 class="order-number">Order #${escapeHtml(orderId ?? '—')}</h2>
                        <span class="source">${escapeHtml(source)}</span>
                    </div>
                    <time class="elapsed" datetime="${escapeHtml(timestamp || '')}" title="${escapeHtml(timestamp || '')}">${escapeHtml(elapsedTime(timestamp))}</time>
                </header>
                <ul class="items">${items.length ? items.map(itemMarkup).join('') : '<li class="item">No item details available.</li>'}</ul>
                <footer class="ticket-footer">
                    <button class="mark-ready" type="button" data-order-id="${escapeHtml(orderId ?? '')}">Mark Ready</button>
                </footer>
            </article>`;
        }

        function renderOrders() {
            tickets.innerHTML = orders.length
                ? orders.map(ticketMarkup).join('')
                : '<p class="empty">No pending orders.</p>';
            lastUpdated.textContent = `Updated ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
        }

        async function loadOrders() {
            try {
                const response = await fetch('/api/kitchen/orders');
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Unable to load orders.');
                orders = Array.isArray(data) ? data : [];
                renderOrders();
            } catch (error) {
                if (orders.length === 0) {
                    tickets.innerHTML = `<p class="error">${escapeHtml(error.message)}</p>`;
                    lastUpdated.textContent = 'Orders unavailable';
                } else {
                    lastUpdated.textContent = `Refresh failed; showing previous results (${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })})`;
                }
            }
        }

        tickets.addEventListener('click', async (event) => {
            const button = event.target.closest('.mark-ready');
            if (!button || button.disabled) return;

            const orderId = button.dataset.orderId;
            if (!orderId) {
                button.textContent = 'Order ID unavailable';
                button.disabled = true;
                return;
            }

            button.disabled = true;
            button.textContent = 'Completing...';
            try {
                const response = await fetch(`/api/kitchen/orders/${encodeURIComponent(orderId)}`, { method: 'PATCH' });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Unable to complete order.');
                orders = orders.filter((order) => String(order.order_id ?? order.id) !== orderId);
                renderOrders();
            } catch (error) {
                button.disabled = false;
                button.textContent = 'Mark Ready';
                button.insertAdjacentHTML('afterend', `<p class="error" role="alert">${escapeHtml(error.message)}</p>`);
            }
        });

        loadOrders();
        setInterval(() => {
            document.querySelectorAll('.elapsed').forEach((element, index) => {
                if (orders[index]) element.textContent = elapsedTime(orders[index].timestamp || orders[index].created_at);
            });
        }, 60000);
        setInterval(loadOrders, 30000);
    </script>
</body>
</html>
