<!DOCTYPE html>
<html lang="en" data-page="kitchen">
<head>
    <%- include('partials/head', { page: 'kitchen', pageTitle: "Kitchen Display — Quality Boba" }) %>
</head>
<body>

    <header class="kds-header">
        <div class="header-left">
            <span class="brand-name">Quality Boba</span>
            <span class="header-divider">/</span>
            <h1>Kitchen Display</h1>
        </div>
        <div class="header-right">
            <span class="last-updated" id="last-updated">Loading orders...</span>
            <div class="a11y-controls" aria-label="Display settings">
                <button type="button" id="large-text-btn" aria-pressed="false">Large text</button>
                <button type="button" id="contrast-btn" aria-pressed="false">High contrast</button>
            </div>
        </div>
        <a href="/logout?next=/kitchen" class="kitchen-logout">Sign out</a>
    </header>

    <main class="board">
        <div class="board-meta">
            <span class="board-title">Active Order Queue</span>
        </div>

        <section class="tickets" id="tickets" aria-live="polite">
            <p class="empty">Loading orders...</p>
        </section>
    </main>

    <dialog id="order-details" class="order-details" aria-labelledby="order-details-title">
        <div class="order-details-card">
            <header class="order-details-header">
                <div>
                    <p class="details-kicker">Order details</p>
                    <h2 id="order-details-title"></h2>
                </div>
                <button type="button" class="details-close" id="order-details-close" aria-label="Close order details">Close</button>
            </header>
            <div id="order-details-content"></div>
        </div>
    </dialog>

    <script src="/js/pages/kitchen.js"></script>
</body>
</html>
