<!DOCTYPE html>
<html lang="en" data-page="cashier">

<head>
    <%- include('partials/head', { page: 'cashier', pageTitle: "Cashier Screen - Quality Boba" }) %>
</head>

<body>

    <!-- Cashier Terminal Header -->
    <header>
        <div class="header-left">
            <div class="brand-title">Quality <span>Boba</span></div>
            <div class="badge-terminal">Cashier POS #1</div>
        </div>
        <div class="header-right">
            <div>Staff: <span class="cashier-user">Reveille (Active)</span></div>
            <div id="liveClock">--:--:--</div>
        </div>
    </header>

    <!-- Main POS Workspace -->
    <main class="workspace">

        <!-- Left: Quick-Touch Catalog & Quick-Modifier Bar -->
        <section class="catalog-container">

            <!-- Category Filter Buttons -->
            <div class="category-tabs">
                <button class="category-btn active" data-action="category" data-category="All">All Items</button>
                <button class="category-btn" data-action="category" data-category="Milk Tea">Milk Tea</button>
                <button class="category-btn" data-action="category" data-category="Fruit Tea">Fruit Tea</button>
                <button class="category-btn" data-action="category" data-category="Specialty">Specialty</button>
                <button class="category-btn" data-action="category" data-category="Toppings">Toppings</button>
            </div>

            <!-- Quick-Modifier Bar (Task 2) -->
            <div class="modifier-bar" id="modifierBar">
                <!-- Sugar % -->
                <div class="modifier-group">
                    <span class="modifier-label">Sugar:</span>
                    <button class="mod-btn sugar" data-action="sugar" data-sugar="0%">0%</button>
                    <button class="mod-btn sugar" data-action="sugar" data-sugar="50%">50%</button>
                    <button class="mod-btn sugar active" data-action="sugar" data-sugar="100%">100%</button>
                </div>

                <!-- Ice Level -->
                <div class="modifier-group">
                    <span class="modifier-label">Ice:</span>
                    <button class="mod-btn ice" data-action="ice" data-ice="No Ice">No Ice</button>
                    <button class="mod-btn ice" data-action="ice" data-ice="Less Ice">Less Ice</button>
                    <button class="mod-btn ice active" data-action="ice" data-ice="Regular Ice">Regular Ice</button>
                </div>

                <!-- Size -->
                <div class="modifier-group">
                    <span class="modifier-label">Size:</span>
                    <button class="mod-btn size active" data-action="size" data-size="Regular (M)" data-extra-price="0.00">Regular</button>
                    <button class="mod-btn size" data-action="size" data-size="Large (L)" data-extra-price="0.75">Large (+$0.75)</button>
                </div>

                <!-- Reset to Defaults -->
                <button class="btn-reset-mods" data-action="reset" title="Reset modifiers to standard defaults">Reset</button>
            </div>

            <!-- Item Touch Grid -->
            <div class="item-grid" id="itemGrid">

                <!-- Milk Tea -->
                <div class="item-card" data-category="Milk Tea" data-action="add" data-code="MT-01" data-name="Classic Pearl Milk Tea" data-price="5.25">
                    <div>
                        <div class="item-code">MT-01</div>
                        <div class="item-name">Classic Pearl Milk Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <div class="item-card" data-category="Milk Tea" data-action="add" data-code="MT-02" data-name="Roasted Oolong Milk Tea" data-price="5.50">
                    <div>
                        <div class="item-code">MT-02</div>
                        <div class="item-name">Roasted Oolong Milk Tea</div>
                    </div>
                    <div class="item-price">$5.50</div>
                </div>

                <div class="item-card" data-category="Milk Tea" data-action="add" data-code="MT-03" data-name="Brown Sugar Fresh Milk" data-price="5.95">
                    <div>
                        <div class="item-code">MT-03</div>
                        <div class="item-name">Brown Sugar Fresh Milk</div>
                    </div>
                    <div class="item-price">$5.95</div>
                </div>

                <div class="item-card" data-category="Milk Tea" data-action="add" data-code="MT-04" data-name="Thai Milk Tea" data-price="5.25">
                    <div>
                        <div class="item-code">MT-04</div>
                        <div class="item-name">Thai Milk Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <!-- Fruit Tea -->
                <div class="item-card" data-category="Fruit Tea" data-action="add" data-code="FT-01" data-name="Mango Green Tea" data-price="5.25">
                    <div>
                        <div class="item-code">FT-01</div>
                        <div class="item-name">Mango Green Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <div class="item-card" data-category="Fruit Tea" data-action="add" data-code="FT-02" data-name="Passionfruit Honey Tea" data-price="5.00">
                    <div>
                        <div class="item-code">FT-02</div>
                        <div class="item-name">Passionfruit Honey Tea</div>
                    </div>
                    <div class="item-price">$5.00</div>
                </div>

                <div class="item-card" data-category="Fruit Tea" data-action="add" data-code="FT-03" data-name="Peach Oolong Tea" data-price="5.25">
                    <div>
                        <div class="item-code">FT-03</div>
                        <div class="item-name">Peach Oolong Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <!-- Specialty -->
                <div class="item-card" data-category="Specialty" data-action="add" data-code="SP-01" data-name="Matcha Cream Latte" data-price="6.00">
                    <div>
                        <div class="item-code">SP-01</div>
                        <div class="item-name">Matcha Cream Latte</div>
                    </div>
                    <div class="item-price">$6.00</div>
                </div>

                <div class="item-card" data-category="Specialty" data-action="add" data-code="SP-02" data-name="Taro Milk Drink" data-price="5.75">
                    <div>
                        <div class="item-code">SP-02</div>
                        <div class="item-name">Taro Milk Drink</div>
                    </div>
                    <div class="item-price">$5.75</div>
                </div>

                <!-- Toppings -->
                <div class="item-card" data-category="Toppings" data-action="add" data-code="TP-01" data-name="Extra Boba Pearls" data-price="0.75">
                    <div>
                        <div class="item-code">TP-01</div>
                        <div class="item-name">Extra Boba Pearls</div>
                    </div>
                    <div class="item-price">$0.75</div>
                </div>

                <div class="item-card" data-category="Toppings" data-action="add" data-code="TP-02" data-name="Egg Pudding" data-price="0.85">
                    <div>
                        <div class="item-code">TP-02</div>
                        <div class="item-name">Egg Pudding</div>
                    </div>
                    <div class="item-price">$0.85</div>
                </div>

                <div class="item-card" data-category="Toppings" data-action="add" data-code="TP-03" data-name="Lychee Jelly" data-price="0.75">
                    <div>
                        <div class="item-code">TP-03</div>
                        <div class="item-name">Lychee Jelly</div>
                    </div>
                    <div class="item-price">$0.75</div>
                </div>

            </div>
        </section>

        <!-- Right Side: Active Ticket Panel (Task 3) -->
        <aside class="ticket-panel">

            <!-- Ticket Header -->
            <div class="ticket-header">
                <div class="ticket-header-title">
                    <h2>Current Ticket</h2>
                    <span class="order-tag" id="orderTag">Order #101</span>
                </div>
                <button class="btn-void" id="btnVoid" data-action="void" disabled>
                    Void Ticket
                </button>
            </div>

            <!-- Scrollable Items Area -->
            <div class="ticket-items-container" id="ticketContainer">
                <div class="ticket-empty" id="ticketEmptyState">
                    <strong class="empty-ticket-title">Ticket is Empty</strong>
                    <p class="empty-ticket-copy">Select modifiers above, then tap any drink to add it to the ticket.</p>
                </div>
            </div>

            <!-- Ticket Footer: Payment, Totals & Submit -->
            <div class="ticket-footer">

                <!-- Payment Method Toggle -->
                <div class="payment-method-bar">
                    <button class="btn-payment active" data-action="payment" data-payment="Card">Card</button>
                    <button class="btn-payment" data-action="payment" data-payment="Cash">Cash</button>
                </div>

                <!-- Calculations Breakdown -->
                <div class="summary-totals">
                    <div class="calc-row">
                        <span>Subtotal:</span>
                        <span id="labelSubtotal">$0.00</span>
                    </div>
                    <div class="calc-row">
                        <span>Texas Tax (8.25%):</span>
                        <span id="labelTax">$0.00</span>
                    </div>
                    <div class="calc-row total-row">
                        <span>Total:</span>
                        <span class="total-amount" id="labelTotal">$0.00</span>
                    </div>
                </div>

                <!-- Submit CTA Button -->
                <button class="btn-submit-order" id="btnSubmit" data-action="submit" disabled>
                    <span>Send to Kitchen</span>
                    <span id="btnSubmitTotal">$0.00</span>
                </button>
            </div>

        </aside>

    </main>

    <!-- Confirmation Toast for Sent Orders -->
    <div class="toast-banner" id="toastBanner">Order Sent to Kitchen</div>

    <script src="/js/shared/money.js"></script>
    <script src="/js/shared/menu.js"></script>
    <script src="/js/pages/cashier.js"></script>
</body>

</html>
