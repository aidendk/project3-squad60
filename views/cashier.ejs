<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cashier Screen - Quality Boba</title>
    <style>
        :root {
            --bg-main: #0f172a;
            --bg-panel: #1e293b;
            --bg-card: #334155;
            --bg-card-hover: #475569;
            --border-color: #475569;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-amber: #f59e0b;
            --accent-green: #10b981;
            --accent-blue: #38bdf8;
            --danger: #ef4444;
            --danger-hover: #dc2626;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Top Bar */
        header {
            background-color: var(--bg-panel);
            border-bottom: 2px solid var(--border-color);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .brand-title {
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #ffffff;
        }

        .brand-title span {
            color: var(--accent-amber);
        }

        .badge-terminal {
            background: rgba(245, 158, 11, 0.15);
            color: var(--accent-amber);
            border: 1px solid rgba(245, 158, 11, 0.3);
            font-size: 0.8rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            text-transform: uppercase;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .cashier-user {
            color: var(--accent-green);
            font-weight: 600;
        }

        /* Main Workspace: 2-Column Split */
        .workspace {
            display: grid;
            grid-template-columns: 1fr 420px;
            flex: 1;
            height: calc(100vh - 60px);
            overflow: hidden;
        }

        /* Left Side: Catalog + Modifier Bar */
        .catalog-container {
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
        }

        /* Category Filter Tabs */
        .category-tabs {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .category-btn {
            background-color: var(--bg-panel);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            padding: 9px 16px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.15s ease;
        }

        .category-btn:hover {
            background-color: var(--bg-card);
            color: var(--text-main);
        }

        .category-btn.active {
            background-color: var(--accent-amber);
            color: #000000;
            border-color: var(--accent-amber);
        }

        /* Quick-Modifier Bar (Task 2) */
        .modifier-bar {
            background-color: var(--bg-panel);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .modifier-group {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .modifier-label {
            font-size: 0.75rem;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-right: 2px;
        }

        .mod-btn {
            background-color: var(--bg-card);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.12s ease;
        }

        .mod-btn:hover {
            background-color: var(--bg-card-hover);
            border-color: var(--accent-blue);
        }

        .mod-btn.active {
            background-color: var(--accent-blue);
            color: #000000;
            border-color: var(--accent-blue);
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
        }

        .mod-btn.sugar.active {
            background-color: #f43f5e;
            color: #ffffff;
            border-color: #f43f5e;
            box-shadow: 0 0 8px rgba(244, 63, 94, 0.4);
        }

        .mod-btn.ice.active {
            background-color: #38bdf8;
            color: #000000;
            border-color: #38bdf8;
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
        }

        .mod-btn.size.active {
            background-color: var(--accent-amber);
            color: #000000;
            border-color: var(--accent-amber);
            box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
        }

        .btn-reset-mods {
            background: transparent;
            border: 1px dashed var(--border-color);
            color: var(--text-muted);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-reset-mods:hover {
            color: var(--text-main);
            border-color: var(--text-muted);
        }

        /* High-Density Item Touch Grid */
        .item-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 12px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .item-card {
            background-color: var(--bg-panel);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 115px;
            cursor: pointer;
            text-align: left;
            transition: transform 0.1s ease, border-color 0.15s ease, background-color 0.15s ease;
        }

        .item-card:hover {
            background-color: var(--bg-card);
            border-color: var(--accent-blue);
        }

        .item-card:active {
            transform: scale(0.97);
            border-color: var(--accent-amber);
        }

        .item-code {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--accent-blue);
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .item-name {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.25;
            color: var(--text-main);
            flex: 1;
        }

        .item-price {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--accent-amber);
            margin-top: 6px;
        }

        /* Right Side: Active Ticket Panel (Task 3) */
        .ticket-panel {
            background-color: var(--bg-panel);
            border-left: 2px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
            overflow: hidden;
        }

        /* Ticket Header */
        .ticket-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15, 23, 42, 0.6);
        }

        .ticket-header-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ticket-header h2 {
            font-size: 1.15rem;
            font-weight: 800;
        }

        .order-tag {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--accent-amber);
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.3);
            padding: 3px 8px;
            border-radius: 4px;
        }

        .btn-void {
            background: rgba(239, 68, 68, 0.12);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .btn-void:hover {
            background: var(--danger);
            color: #ffffff;
            border-color: var(--danger);
        }

        .btn-void:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            pointer-events: none;
        }

        /* Ticket Items Container */
        .ticket-items-container {
            flex: 1;
            overflow-y: auto;
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .ticket-empty {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--text-muted);
            gap: 8px;
            padding: 30px 20px;
        }

        .ticket-empty-icon {
            font-size: 2.8rem;
            opacity: 0.35;
        }

        /* Line Item Card */
        .ticket-row {
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 10px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            transition: border-color 0.15s ease;
        }

        .ticket-row:hover {
            border-color: var(--border-color);
        }

        .row-details {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .row-name {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .row-modifiers {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            font-size: 0.75rem;
        }

        .tag-mod {
            background: rgba(15, 23, 42, 0.6);
            padding: 2px 6px;
            border-radius: 4px;
            color: #bae6fd;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .row-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stepper {
            display: flex;
            align-items: center;
            background: var(--bg-panel);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            overflow: hidden;
        }

        .stepper-btn {
            background: transparent;
            color: var(--text-main);
            border: none;
            width: 26px;
            height: 26px;
            font-size: 0.9rem;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.1s ease;
        }

        .stepper-btn:hover {
            background-color: var(--bg-card-hover);
            color: var(--accent-amber);
        }

        .stepper-qty {
            min-width: 22px;
            text-align: center;
            font-size: 0.85rem;
            font-weight: 700;
            color: #ffffff;
        }

        .row-price {
            font-size: 1rem;
            font-weight: 800;
            color: var(--accent-amber);
            min-width: 58px;
            text-align: right;
        }

        .btn-remove-item {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.2rem;
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
            transition: color 0.15s ease;
        }

        .btn-remove-item:hover {
            color: var(--danger);
        }

        /* Ticket Footer / Calculations Panel */
        .ticket-footer {
            border-top: 2px solid var(--border-color);
            background: rgba(15, 23, 42, 0.7);
            padding: 14px 18px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Payment Selector */
        .payment-method-bar {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .btn-payment {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 8px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s ease;
            text-align: center;
        }

        .btn-payment:hover {
            color: var(--text-main);
            border-color: var(--accent-blue);
        }

        .btn-payment.active {
            background: var(--accent-blue);
            color: #000000;
            border-color: var(--accent-blue);
            font-weight: 800;
        }

        /* Financial Breakdown */
        .summary-totals {
            display: flex;
            flex-direction: column;
            gap: 4px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
        }

        .calc-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        .calc-row.total-row {
            font-size: 1.35rem;
            font-weight: 900;
            color: var(--text-main);
            margin-top: 4px;
        }

        .calc-row.total-row .total-amount {
            color: var(--accent-amber);
        }

        /* Action Buttons */
        .btn-submit-order {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 1.05rem;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
            transition: all 0.15s ease;
        }

        .btn-submit-order:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
        }

        .btn-submit-order:active {
            transform: translateY(0);
        }

        .btn-submit-order:disabled {
            background: var(--bg-card);
            color: var(--text-muted);
            box-shadow: none;
            cursor: not-allowed;
            transform: none;
            opacity: 0.6;
        }

        /* Confirmation Toast */
        .toast-banner {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #065f46;
            color: #ecfdf5;
            border: 1px solid #10b981;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 700;
            display: none;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
            z-index: 1000;
            animation: fadeIn 0.2s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<body>

    <!-- Cashier Terminal Header -->
    <header>
        <div class="header-left">
            <div class="brand-title">Quality <span>Boba</span></div>
            <div class="badge-terminal">Cashier POS #1</div>
        </div>
        <div class="header-right">
            <div>Staff: <span class="cashier-user">Reveille (Active)</span></div>
            <div id="liveClock">--:--:--</div>
        </div>
    </header>

    <!-- Main POS Workspace -->
    <main class="workspace">

        <!-- Left: Quick-Touch Catalog & Quick-Modifier Bar -->
        <section class="catalog-container">

            <!-- Category Filter Buttons -->
            <div class="category-tabs">
                <button class="category-btn active" onclick="filterCategory('All', this)">All Items</button>
                <button class="category-btn" onclick="filterCategory('Milk Tea', this)">Milk Tea</button>
                <button class="category-btn" onclick="filterCategory('Fruit Tea', this)">Fruit Tea</button>
                <button class="category-btn" onclick="filterCategory('Specialty', this)">Specialty</button>
                <button class="category-btn" onclick="filterCategory('Toppings', this)">Toppings</button>
            </div>

            <!-- Quick-Modifier Bar (Task 2) -->
            <div class="modifier-bar" id="modifierBar">
                <!-- Sugar % -->
                <div class="modifier-group">
                    <span class="modifier-label">Sugar:</span>
                    <button class="mod-btn sugar" onclick="setSugar('0%', this)">0%</button>
                    <button class="mod-btn sugar" onclick="setSugar('50%', this)">50%</button>
                    <button class="mod-btn sugar active" onclick="setSugar('100%', this)">100%</button>
                </div>

                <!-- Ice Level -->
                <div class="modifier-group">
                    <span class="modifier-label">Ice:</span>
                    <button class="mod-btn ice" onclick="setIce('No Ice', this)">No Ice</button>
                    <button class="mod-btn ice" onclick="setIce('Less Ice', this)">Less Ice</button>
                    <button class="mod-btn ice active" onclick="setIce('Regular Ice', this)">Regular Ice</button>
                </div>

                <!-- Size -->
                <div class="modifier-group">
                    <span class="modifier-label">Size:</span>
                    <button class="mod-btn size active" onclick="setSize('Regular (M)', 0.00, this)">Regular</button>
                    <button class="mod-btn size" onclick="setSize('Large (L)', 0.75, this)">Large (+$0.75)</button>
                </div>

                <!-- Reset to Defaults -->
                <button class="btn-reset-mods" onclick="resetModifiers()" title="Reset modifiers to standard defaults">Reset</button>
            </div>

            <!-- Item Touch Grid -->
            <div class="item-grid" id="itemGrid">

                <!-- Milk Tea -->
                <div class="item-card" data-category="Milk Tea" onclick="handleItemTap('MT-01', 'Classic Pearl Milk Tea', 5.25)">
                    <div>
                        <div class="item-code">MT-01</div>
                        <div class="item-name">Classic Pearl Milk Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <div class="item-card" data-category="Milk Tea" onclick="handleItemTap('MT-02', 'Roasted Oolong Milk Tea', 5.50)">
                    <div>
                        <div class="item-code">MT-02</div>
                        <div class="item-name">Roasted Oolong Milk Tea</div>
                    </div>
                    <div class="item-price">$5.50</div>
                </div>

                <div class="item-card" data-category="Milk Tea" onclick="handleItemTap('MT-03', 'Brown Sugar Fresh Milk', 5.95)">
                    <div>
                        <div class="item-code">MT-03</div>
                        <div class="item-name">Brown Sugar Fresh Milk</div>
                    </div>
                    <div class="item-price">$5.95</div>
                </div>

                <div class="item-card" data-category="Milk Tea" onclick="handleItemTap('MT-04', 'Thai Milk Tea', 5.25)">
                    <div>
                        <div class="item-code">MT-04</div>
                        <div class="item-name">Thai Milk Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <!-- Fruit Tea -->
                <div class="item-card" data-category="Fruit Tea" onclick="handleItemTap('FT-01', 'Mango Green Tea', 5.25)">
                    <div>
                        <div class="item-code">FT-01</div>
                        <div class="item-name">Mango Green Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <div class="item-card" data-category="Fruit Tea" onclick="handleItemTap('FT-02', 'Passionfruit Honey Tea', 5.00)">
                    <div>
                        <div class="item-code">FT-02</div>
                        <div class="item-name">Passionfruit Honey Tea</div>
                    </div>
                    <div class="item-price">$5.00</div>
                </div>

                <div class="item-card" data-category="Fruit Tea" onclick="handleItemTap('FT-03', 'Peach Oolong Tea', 5.25)">
                    <div>
                        <div class="item-code">FT-03</div>
                        <div class="item-name">Peach Oolong Tea</div>
                    </div>
                    <div class="item-price">$5.25</div>
                </div>

                <!-- Specialty -->
                <div class="item-card" data-category="Specialty" onclick="handleItemTap('SP-01', 'Matcha Cream Latte', 6.00)">
                    <div>
                        <div class="item-code">SP-01</div>
                        <div class="item-name">Matcha Cream Latte</div>
                    </div>
                    <div class="item-price">$6.00</div>
                </div>

                <div class="item-card" data-category="Specialty" onclick="handleItemTap('SP-02', 'Taro Milk Drink', 5.75)">
                    <div>
                        <div class="item-code">SP-02</div>
                        <div class="item-name">Taro Milk Drink</div>
                    </div>
                    <div class="item-price">$5.75</div>
                </div>

                <!-- Toppings -->
                <div class="item-card" data-category="Toppings" onclick="handleItemTap('TP-01', 'Extra Boba Pearls', 0.75)">
                    <div>
                        <div class="item-code">TP-01</div>
                        <div class="item-name">Extra Boba Pearls</div>
                    </div>
                    <div class="item-price">$0.75</div>
                </div>

                <div class="item-card" data-category="Toppings" onclick="handleItemTap('TP-02', 'Egg Pudding', 0.85)">
                    <div>
                        <div class="item-code">TP-02</div>
                        <div class="item-name">Egg Pudding</div>
                    </div>
                    <div class="item-price">$0.85</div>
                </div>

                <div class="item-card" data-category="Toppings" onclick="handleItemTap('TP-03', 'Lychee Jelly', 0.75)">
                    <div>
                        <div class="item-code">TP-03</div>
                        <div class="item-name">Lychee Jelly</div>
                    </div>
                    <div class="item-price">$0.75</div>
                </div>

            </div>
        </section>

        <!-- Right Side: Active Ticket Panel (Task 3) -->
        <aside class="ticket-panel">
            
            <!-- Ticket Header -->
            <div class="ticket-header">
                <div class="ticket-header-title">
                    <h2>Current Ticket</h2>
                    <span class="order-tag" id="orderTag">Order #101</span>
                </div>
                <button class="btn-void" id="btnVoid" onclick="voidTicket()" disabled>
                    <span>🗑</span> Void Ticket
                </button>
            </div>

            <!-- Scrollable Items Area -->
            <div class="ticket-items-container" id="ticketContainer">
                <div class="ticket-empty" id="ticketEmptyState">
                    <div class="ticket-empty-icon">📋</div>
                    <strong style="color: var(--text-main);">Ticket is Empty</strong>
                    <p style="font-size: 0.85rem;">Select modifiers above, then tap any drink to add it to the ticket.</p>
                </div>
            </div>

            <!-- Ticket Footer: Payment, Totals & Submit -->
            <div class="ticket-footer">
                
                <!-- Payment Method Toggle -->
                <div class="payment-method-bar">
                    <button class="btn-payment active" onclick="setPaymentMethod('Card', this)">💳 Card</button>
                    <button class="btn-payment" onclick="setPaymentMethod('Cash', this)">💵 Cash</button>
                </div>

                <!-- Calculations Breakdown -->
                <div class="summary-totals">
                    <div class="calc-row">
                        <span>Subtotal:</span>
                        <span id="labelSubtotal">$0.00</span>
                    </div>
                    <div class="calc-row">
                        <span>Texas Tax (8.25%):</span>
                        <span id="labelTax">$0.00</span>
                    </div>
                    <div class="calc-row total-row">
                        <span>Total:</span>
                        <span class="total-amount" id="labelTotal">$0.00</span>
                    </div>
                </div>

                <!-- Submit CTA Button -->
                <button class="btn-submit-order" id="btnSubmit" onclick="submitTicket()" disabled>
                    <span>⚡ Send to Kitchen</span>
                    <span id="btnSubmitTotal">$0.00</span>
                </button>
            </div>

        </aside>

    </main>

    <!-- Confirmation Toast for Sent Orders -->
    <div class="toast-banner" id="toastBanner">✓ Order Sent to Kitchen!</div>

    <script>
        // Update Live Clock
        function updateClock() {
            const now = new Date();
            document.getElementById('liveClock').textContent = now.toLocaleTimeString();
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Active Modifiers State (Task 2)
        const activeModifiers = {
            sugar: '100%',
            ice: 'Regular Ice',
            size: 'Regular (M)',
            extraPrice: 0.00
        };

        // Active Ticket State (Task 3)
        let ticketItems = [];
        let orderNumber = 101;
        let selectedPayment = 'Card';
        const TAX_RATE = 0.0825; // 8.25% Texas State Tax

        // Modifier controls
        function setSugar(level, btn) {
            document.querySelectorAll('.mod-btn.sugar').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeModifiers.sugar = level;
        }

        function setIce(level, btn) {
            document.querySelectorAll('.mod-btn.ice').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeModifiers.ice = level;
        }

        function setSize(size, extra, btn) {
            document.querySelectorAll('.mod-btn.size').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeModifiers.size = size;
            activeModifiers.extraPrice = extra;
        }

        function resetModifiers() {
            activeModifiers.sugar = '100%';
            activeModifiers.ice = 'Regular Ice';
            activeModifiers.size = 'Regular (M)';
            activeModifiers.extraPrice = 0.00;

            document.querySelectorAll('.mod-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.mod-btn.sugar')[2].classList.add('active'); // 100%
            document.querySelectorAll('.mod-btn.ice')[2].classList.add('active');   // Regular Ice
            document.querySelectorAll('.mod-btn.size')[0].classList.add('active');  // Regular
        }

        // Category Filtering
        function filterCategory(category, button) {
            document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');

            const cards = document.querySelectorAll('.item-card');
            cards.forEach(card => {
                if (category === 'All' || card.getAttribute('data-category') === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Add item to ticket when tapped
        function handleItemTap(code, name, basePrice) {
            const unitPrice = parseFloat((basePrice + activeModifiers.extraPrice).toFixed(2));
            
            // Check if exact same item with exact same customizations already exists
            const existingIndex = ticketItems.findIndex(item => 
                item.code === code &&
                item.sugar === activeModifiers.sugar &&
                item.ice === activeModifiers.ice &&
                item.size === activeModifiers.size
            );

            if (existingIndex > -1) {
                ticketItems[existingIndex].quantity += 1;
            } else {
                ticketItems.push({
                    id: Date.now() + Math.random(),
                    code: code,
                    name: name,
                    size: activeModifiers.size,
                    sugar: activeModifiers.sugar,
                    ice: activeModifiers.ice,
                    unitPrice: unitPrice,
                    quantity: 1
                });
            }

            renderTicket();
        }

        // Adjust quantity in ticket
        function changeQuantity(index, delta) {
            if (!ticketItems[index]) return;
            ticketItems[index].quantity += delta;
            if (ticketItems[index].quantity <= 0) {
                ticketItems.splice(index, 1);
            }
            renderTicket();
        }

        // Remove item from ticket
        function removeItem(index) {
            ticketItems.splice(index, 1);
            renderTicket();
        }

        // Void entire ticket with confirmation
        function voidTicket() {
            if (ticketItems.length === 0) return;
            if (confirm('Void the current ticket? All selected items will be cleared.')) {
                ticketItems = [];
                renderTicket();
            }
        }

        // Set payment method
        function setPaymentMethod(method, btn) {
            selectedPayment = method;
            document.querySelectorAll('.btn-payment').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        // Render ticket items and recalculate tax & totals
        function renderTicket() {
            const container = document.getElementById('ticketContainer');
            const btnVoid = document.getElementById('btnVoid');
            const btnSubmit = document.getElementById('btnSubmit');

            if (ticketItems.length === 0) {
                container.innerHTML = `
                    <div class="ticket-empty" id="ticketEmptyState">
                        <div class="ticket-empty-icon">📋</div>
                        <strong style="color: var(--text-main);">Ticket is Empty</strong>
                        <p style="font-size: 0.85rem;">Select modifiers above, then tap any drink to add it to the ticket.</p>
                    </div>
                `;
                btnVoid.disabled = true;
                btnSubmit.disabled = true;
                updateTotals(0, 0, 0);
                return;
            }

            btnVoid.disabled = false;
            btnSubmit.disabled = false;

            let html = '';
            let subtotal = 0;

            ticketItems.forEach((item, index) => {
                const itemTotal = item.unitPrice * item.quantity;
                subtotal += itemTotal;

                html += `
                    <div class="ticket-row">
                        <div class="row-details">
                            <div class="row-name">${item.name}</div>
                            <div class="row-modifiers">
                                <span class="tag-mod">🍬 ${item.sugar}</span>
                                <span class="tag-mod">❄️ ${item.ice}</span>
                                <span class="tag-mod">📏 ${item.size}</span>
                            </div>
                        </div>
                        <div class="row-controls">
                            <div class="stepper">
                                <button class="stepper-btn" onclick="changeQuantity(${index}, -1)">-</button>
                                <span class="stepper-qty">${item.quantity}</span>
                                <button class="stepper-btn" onclick="changeQuantity(${index}, 1)">+</button>
                            </div>
                            <div class="row-price">$${itemTotal.toFixed(2)}</div>
                            <button class="btn-remove-item" onclick="removeItem(${index})" title="Remove Item">&times;</button>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;

            // Calculations
            const tax = subtotal * TAX_RATE;
            const total = subtotal + tax;

            updateTotals(subtotal, tax, total);
        }

        // Update total labels in DOM
        function updateTotals(subtotal, tax, total) {
            document.getElementById('labelSubtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('labelTax').textContent = `$${tax.toFixed(2)}`;
            document.getElementById('labelTotal').textContent = `$${total.toFixed(2)}`;
            document.getElementById('btnSubmitTotal').textContent = `$${total.toFixed(2)}`;
        }

        // Submit Ticket / Send to Kitchen (Task 4 Backend Integration)
        async function submitTicket() {
            if (ticketItems.length === 0) return;

            const btnSubmit = document.getElementById('btnSubmit');
            const originalBtnHtml = btnSubmit.innerHTML;
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<span>⏳ Processing Order...</span><span></span>';

            const subtotal = ticketItems.reduce((acc, item) => acc + (item.unitPrice * item.quantity), 0);
            const tax = subtotal * TAX_RATE;
            const total = subtotal + tax;

            // Structured payload matching Task 4 API requirements
            const orderPayload = {
                cashier_id: 'Reveille',
                payment_method: selectedPayment,
                items: ticketItems.map(i => ({
                    code: i.code,
                    name: i.name,
                    size: i.size,
                    sugar: i.sugar,
                    ice: i.ice,
                    quantity: i.quantity,
                    unit_price: i.unitPrice,
                    line_total: parseFloat((i.unitPrice * i.quantity).toFixed(2))
                })),
                subtotal: parseFloat(subtotal.toFixed(2)),
                tax: parseFloat(tax.toFixed(2)),
                total: parseFloat(total.toFixed(2)),
                timestamp: new Date().toISOString()
            };

            const toast = document.getElementById('toastBanner');

            try {
                const response = await fetch('/api/cashier/order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderPayload)
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    toast.style.background = '#065f46';
                    toast.style.borderColor = '#10b981';
                    toast.textContent = `✓ Order #${data.order_id} Committed to PostgreSQL & Sent to Kitchen!`;
                    orderNumber = data.order_id + 1;
                    document.getElementById('orderTag').textContent = `Order #${orderNumber}`;
                    ticketItems = [];
                    renderTicket();
                } else {
                    console.warn('API returned non-200 status:', data);
                    toast.style.background = '#854d0e';
                    toast.style.borderColor = '#f59e0b';
                    toast.textContent = `⚠️ Order #${orderNumber} recorded locally (${data.error || 'DB Offline'}). Sent to Kitchen!`;
                    orderNumber += 1;
                    document.getElementById('orderTag').textContent = `Order #${orderNumber}`;
                    ticketItems = [];
                    renderTicket();
                }
            } catch (err) {
                console.error('Fetch error submitting order:', err);
                toast.style.background = '#854d0e';
                toast.style.borderColor = '#f59e0b';
                toast.textContent = `⚠️ Network offline. Order #${orderNumber} recorded locally & Sent to Kitchen!`;
                orderNumber += 1;
                document.getElementById('orderTag').textContent = `Order #${orderNumber}`;
                ticketItems = [];
                renderTicket();
            } finally {
                toast.style.display = 'block';
                setTimeout(() => {
                    toast.style.display = 'none';
                }, 4000);
                btnSubmit.innerHTML = originalBtnHtml;
            }
        }
    </script>
</body>

</html>
