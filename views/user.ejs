<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Members - Quality Boba (Squad 60)</title>
    <style>
        :root {
            --bg-main: #f4ece1;
            --bg-card: #fffdf9;
            --border-color: #e3d5c4;
            --text-main: #24180f;
            --text-muted: #6b5747;
            --brand: #4e2c1c;
            --accent-green: #2e6f40;
            --accent-green-light: #eaf3ec;
            --shadow-sm: 0 4px 14px rgba(62, 36, 18, 0.06);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            padding: 40px 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            max-width: 700px;
            width: 100%;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 32px;
            box-shadow: var(--shadow-sm);
        }
        h1 {
            color: var(--brand);
            font-size: 1.8rem;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sub {
            color: var(--text-muted);
            margin-bottom: 24px;
        }
        .member-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .member-card {
            background: #fbf7f0;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 16px 20px;
        }
        .member-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--brand);
            margin-bottom: 4px;
        }
        .member-details {
            font-size: 0.9rem;
            color: var(--text-muted);
        }
        .tag {
            display: inline-block;
            background: var(--accent-green-light);
            color: var(--accent-green);
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.8rem;
            margin-left: 6px;
        }

        /* Vishnu Accessibility: Keyboard Focus Indicators & WCAG AAA Contrast */
        *:focus-visible {
            outline: 3px solid #4e2c1c !important;
            outline-offset: 2px !important;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .contrast-toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.12);
            color: #fffdf9;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .contrast-toggle-btn:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: #ffffff;
        }

        /* WCAG 2.1 AAA High Contrast Palette for Vishnu */
        html.high-contrast,
        html.high-contrast body {
            background-color: #000000 !important;
            color: #ffffff !important;
        }

        html.high-contrast *:focus-visible {
            outline: 3px solid #ffd700 !important;
            outline-offset: 3px !important;
        }

        html.high-contrast header {
            background-color: #000000 !important;
            border-bottom: 3px solid #ffffff !important;
            color: #ffffff !important;
        }

        html.high-contrast .contrast-toggle-btn {
            background: #ffd700 !important;
            color: #000000 !important;
            border: 2px solid #ffffff !important;
            font-weight: 800 !important;
        }

        html.high-contrast .member-card {
            background: #000000 !important;
            border: 2px solid #ffffff !important;
            color: #ffffff !important;
            box-shadow: none !important;
        }

        html.high-contrast .member-card:hover,
        html.high-contrast .member-card:focus-visible {
            border-color: #ffd700 !important;
            background: #141414 !important;
        }

        html.high-contrast .member-name {
            color: #ffd700 !important;
            text-decoration: underline !important;
            font-weight: 800 !important;
        }

        html.high-contrast .member-role {
            color: #ffffff !important;
        }

        html.high-contrast footer {
            border-top: 1px solid #ffffff !important;
            color: #ffffff !important;
        }
    </style>
</head>
<body>
    <main class="container">
        <h1>Squad 60 Team Members</h1>
        <p class="sub">Quality Boba Point of Sale &bull; CSCE 331</p>
        <div class="member-list">
            <% for (var i in teammembers) { %>
                <div class="member-card">
                    <div class="member-name"><%= teammembers[i].student_name %> <span class="tag">Section <%= teammembers[i].section %></span></div>
                    <div class="member-details">Favorite Movie: <strong><%= teammembers[i].favorite_movie %></strong></div>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Vishnu Accessibility Controller (WCAG 2.1 AAA High Contrast) -->
    <script>
    (function() {
        const contrastBtn = document.getElementById('contrast-toggle-btn');
        const contrastStateText = contrastBtn ? contrastBtn.querySelector('.contrast-state-text') : null;
        const announcer = document.getElementById('a11y-announcer');

        function setHighContrast(enable, announce) {
            document.documentElement.classList.toggle('high-contrast', enable);
            if (contrastBtn) {
                contrastBtn.setAttribute('aria-pressed', enable ? 'true' : 'false');
            }
            if (contrastStateText) {
                contrastStateText.textContent = enable ? 'On' : 'Off';
            }
            try {
                localStorage.setItem('qb_contrast', enable ? 'high' : 'normal');
                sessionStorage.setItem('kiosk-contrast', enable ? 'on' : 'off');
            } catch (e) {}

            if (announce && announcer) {
                announcer.textContent = enable
                    ? 'High contrast mode enabled. Contrast ratio exceeds WCAG 2.1 AAA standard.'
                    : 'High contrast mode disabled.';
            }
        }

        // Initialize from localStorage or sessionStorage
        const isHigh = (function() {
            try {
                return localStorage.getItem('qb_contrast') === 'high' || sessionStorage.getItem('kiosk-contrast') === 'on';
            } catch (e) {
                return false;
            }
        })();

        if (isHigh) {
            setHighContrast(true, false);
        }

        if (contrastBtn) {
            contrastBtn.addEventListener('click', function() {
                const current = document.documentElement.classList.contains('high-contrast');
                setHighContrast(!current, true);
            });
        }
    })();
    </script>

</body>
</html>
