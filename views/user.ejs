<!DOCTYPE html>
<html lang="en" data-page="user">
<head>
    <%- include('partials/head', { page: 'user', pageTitle: "Team Members - Quality Boba (Squad 60)" }) %>
</head>
<body>
    <main class="container">
        <h1>Squad 60 Team Members</h1>
        <p class="sub">Quality Boba Point of Sale &bull; CSCE 331</p>
        <div class="member-list">
            <% for (var i in teammembers) { %>
                <div class="member-card">
                    <div class="member-name"><%= teammembers[i].student_name %> <span class="tag">Section <%= teammembers[i].section %></span></div>
                    <div class="member-details">Favorite Movie: <strong><%= teammembers[i].favorite_movie %></strong></div>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
