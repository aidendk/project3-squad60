<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Members - Quality Boba (Squad 60)</title>
    <style>
        :root {
            --bg-main: #f4ece1;
            --bg-card: #fffdf9;
            --border-color: #e3d5c4;
            --text-main: #24180f;
            --text-muted: #6b5747;
            --brand: #4e2c1c;
            --accent-green: #2e6f40;
            --accent-green-light: #eaf3ec;
            --shadow-sm: 0 4px 14px rgba(62, 36, 18, 0.06);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            padding: 40px 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            max-width: 700px;
            width: 100%;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 32px;
            box-shadow: var(--shadow-sm);
        }
        h1 {
            color: var(--brand);
            font-size: 1.8rem;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sub {
            color: var(--text-muted);
            margin-bottom: 24px;
        }
        .member-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .member-card {
            background: #fbf7f0;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 16px 20px;
        }
        .member-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--brand);
            margin-bottom: 4px;
        }
        .member-details {
            font-size: 0.9rem;
            color: var(--text-muted);
        }
        .tag {
            display: inline-block;
            background: var(--accent-green-light);
            color: var(--accent-green);
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.8rem;
            margin-left: 6px;
        }
    </style>
</head>
<body>
    <main class="container">
        <h1>🧋 Squad 60 Team Members</h1>
        <p class="sub">Quality Boba Point of Sale &bull; CSCE 331</p>
        <div class="member-list">
            <% for (var i in teammembers) { %>
                <div class="member-card">
                    <div class="member-name"><%= teammembers[i].student_name %> <span class="tag">Section <%= teammembers[i].section %></span></div>
                    <div class="member-details">Favorite Movie: <strong><%= teammembers[i].favorite_movie %></strong></div>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
